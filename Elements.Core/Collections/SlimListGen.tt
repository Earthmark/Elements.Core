// Autogenerated!!! DO NOT MODIFY!
// Generated on: <#= DateTime.Now #>

using System;
using System.Collections;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace Elements.Core
{
    <#for(int n = 0; n < 2; n++)
    {
        bool isPoolVersion = n == 1;

        string typeName = isPoolVersion ? "SlimPoolList<T>" : "SlimList<T>";
        #>

    public struct <#=typeName#> : IList<T>, IReadOnlyList<T>
    {
        // Important!!! This is used only as a marker to signify that the SlimList is currently storing
        // a single item, and is not used for actual storage!
        static List<T> SINGLE_ITEM_MARKER = new List<T>(1) { default };

        public struct Enumerator : IEnumerator<T>
        {
            enum Mode : byte
            {
                Empty,
                SingleItemStart,
                SingleItemCurrent,
                SingleItemFinished,
                ItemList,
                Disposed
            }

            T _singleItem;
            List<T>.Enumerator _listEnumerator;
            Mode _mode;

            public Enumerator(<#=typeName#> list)
            {
                if(list.HasSingleItem)
                {
                    _singleItem = list._item;
                    _mode = Mode.SingleItemStart;

                    _listEnumerator = default;
                }
                else if(list._items != null)
                {
                    _listEnumerator = list._items.GetEnumerator();
                    _mode = Mode.ItemList;

                    _singleItem = default;
                }
                else
                {
                    _mode = Mode.Empty;

                    _listEnumerator = default;
                    _singleItem = default;
                }
            }

            public T Current
            {
                get
                {
                    switch(_mode)
                    {
                        case Mode.ItemList:
                            return _listEnumerator.Current;

                        case Mode.SingleItemCurrent:
                            return _singleItem;

                        default:
                            return default;
                    }
                }
            }

            object IEnumerator.Current => Current;

            public void Dispose()
            {
                switch(_mode)
                {
                    case Mode.ItemList:
                        _listEnumerator.Dispose();
                        break;

                    default:
                        _singleItem = default;
                        break;
                }

                _mode = Mode.Disposed;
            }

            public bool MoveNext()
            {
                switch(_mode)
                {
                    case Mode.ItemList:
                        return _listEnumerator.MoveNext();

                    case Mode.SingleItemStart:
                        _mode = Mode.SingleItemCurrent;
                        return true;

                    case Mode.SingleItemCurrent:
                        _mode = Mode.SingleItemFinished;
                        return false;

                    case Mode.Empty:
                        return false;

                    default:
                        return false;
                }
            }

            public void Reset()
            {
                switch(_mode)
                {
                    case Mode.SingleItemStart:
                    case Mode.SingleItemCurrent:
                    case Mode.SingleItemFinished:
                        _mode = Mode.SingleItemStart;
                        break;

                    case Mode.ItemList:
                        ((IEnumerator)_listEnumerator).Reset();
                        break;
                }
            }
        }

        List<T> _items;
        T _item;

        public bool HasSingleItem => _items == SINGLE_ITEM_MARKER;
        public bool UsesMultiItemStorage => _items != SINGLE_ITEM_MARKER;

        public T this[int index]
        {
            get
            {
                if (HasSingleItem)
                {
                    if (index != 0)
                        throw new ArgumentOutOfRangeException(nameof(index));

                    return _item;
                }
                else
                    return _items[index];
            }

            set
            {
                if (HasSingleItem)
                {
                    if (index != 0)
                        throw new ArgumentOutOfRangeException(nameof(index));

                    _item = value;
                }
                else
                    _items[index] = value;
            }
        }

        public int Count => _items?.Count ?? 0;

        public bool IsReadOnly => false;

        public void Add(T item)
        {
            var _currentCount = Count;

            if(_currentCount == 0)
            {
                _item = item;
                _items = SINGLE_ITEM_MARKER;

                return;
            }

            if (_currentCount == 1)
                ConvertToListStorage();

            _items.Add(item);
        }

        public void Clear()
        {
            <#if(isPoolVersion) { #> if(Count > 1)
                Pool.Return(ref _items); <# } #>


            _item = default;
            _items = null;
        }

        public bool Contains(T item)
        {
            if (HasSingleItem)
                return item.Equals(_item);

            if (_items == null)
                return false;

            return _items.Contains(item);
        }

        public void CopyTo(T[] array, int arrayIndex)
        {
            if(HasSingleItem)
            {
                array[arrayIndex] = _item;
                return;
            }

            if (_items == null)
                return;

            _items.CopyTo(array, arrayIndex);
        }

        public <#=typeName#>.Enumerator GetEnumerator() => new Enumerator(this);

        public int IndexOf(T item)
        {
            if(HasSingleItem)
            {
                if (EqualityComparer<T>.Default.Equals(_item, item))
                    return 0;

                return -1;
            }

            if (_items == null)
                return -1;

            return _items.IndexOf(item);
        }

        public void Insert(int index, T item)
        {
            var _currentCount = Count;

            if (_currentCount == 0)
            {
                // using empty list, must make it into a single item
                if (index != 0)
                    throw new ArgumentOutOfRangeException(nameof(index));

                _item = item;
                _items = SINGLE_ITEM_MARKER;

                return;
            }

            if (_currentCount == 1)
                ConvertToListStorage();

            _items.Insert(index, item);
        }

        public bool Remove(T item)
        {
            if (HasSingleItem)
            { 
                if(EqualityComparer<T>.Default.Equals(_item, item))
                {
                    Clear();
                    return true;
                }

                return false;
            }

            if (_items == null)
                return false;

            if(_items.Remove(item))
            {
                CheckConvertToSingleItem();
                return true;
            }

            return false;
        }

        public void RemoveAt(int index)
        {
            if (HasSingleItem)
            {
                if (index != 0)
                    throw new ArgumentOutOfRangeException(nameof(index));

                Clear();
            }
            else if (_items != null)
            {
                _items.RemoveAt(index);
                CheckConvertToSingleItem();
            }
        }

        public int RemoveAll(Predicate<T> predicate)
        {
            if(HasSingleItem)
            {
                if (predicate(_item))
                {
                    Clear();
                    return 1;
                }

                return 0;
            }
            else if(_items != null)
            {
                var count = _items.RemoveAll(predicate);
                CheckConvertToSingleItem();
                return count;
            }

            return 0;
        }

        public void Sort(Comparison<T> comparison)
        {
            // no sorting necessary
            if (Count < 2)
                return;

            _items.Sort(comparison);
        }

        void CheckConvertToSingleItem()
        {
            if(_items.Count == 1)
            {
                _item = _items[0];

                <#if(isPoolVersion) { #> Pool.Return(ref _items); <# } #>

                _items = SINGLE_ITEM_MARKER;
            }
        }

        void ConvertToListStorage()
        {
            if (_items != SINGLE_ITEM_MARKER)
                throw new InvalidOperationException("Cannot convert to list storage when list is already allocated!");

            _items = <#=isPoolVersion ? "Pool.BorrowList<T>()" : "new List<T>()"#>;
            _items.Add(_item);

            _item = default;
        }

        IEnumerator<T> IEnumerable<T>.GetEnumerator() => GetEnumerator();

        IEnumerator IEnumerable.GetEnumerator() => GetEnumerator();
    }

    <#}#>
}
