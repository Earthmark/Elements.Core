        /// <summary>
        /// Applies a supplied gamma curve to this colorX.  Note inverse gammas must be pre-inverted by dividing 1 by gamma prior to calling this.
        /// </summary>
        /// <param name="gamma">
        /// A gamma curve to apply in the event of any component being HDR.
