        /// A colorX with the supplied gamma applied to any HDR values.
        /// </returns>
	    [MethodImpl(MethodImplOptions.AggressiveInlining)]
        public readonly colorX ApplyHDRGamma(float gamma)
        {
            float r = baseColor.r;
            float g = baseColor.g;
            float b = baseColor.b;

            if (r > 1)
            {
                r = MathX.Pow(r, gamma);
            }

            if (g > 1)
            {
                g = MathX.Pow(g, gamma);
            }

            if (b > 1)
            {
                b = MathX.Pow(b, gamma);
            }

            return new colorX(r, g, b, baseColor.a, profile);
        }

