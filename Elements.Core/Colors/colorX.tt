    public static partial class MathX
    {
	    public static colorX Lerp(in colorX a, in colorX b, float lerp, ColorProfileAwareOperation option = ColorProfileAwareOperation.UseLHS)
	    {
		    if (lerp <= 0)
			    return a;

		    if (lerp >= 1f)
			    return b;

		    return LerpUnclamped(a, b, lerp, option);
	    }

	    public static colorX LerpUnclamped(in colorX a, in colorX b, float lerp, ColorProfileAwareOperation option = ColorProfileAwareOperation.UseLHS)
	    {
		    float ak = 1 - lerp;
		    float bk = lerp;

			var colors = ColorProfileHelper.GetOperands(a, b, option);

		    return new colorX(
			    colors.leftHand.r * ak + colors.rightHand.r * bk,
			    colors.leftHand.g * ak + colors.rightHand.g * bk,
			    colors.leftHand.b * ak + colors.rightHand.b * bk,
			    colors.leftHand.a * ak + colors.rightHand.a * bk,
			    colors.profile);
	    }

        public static colorX InverseLerp(in colorX from, in colorX to, in colorX value) =>
            new colorX(MathX.InverseLerp(from.ToProfile(value.profile), to.ToProfile(value.profile), value.baseColor), value.profile);

        public static float Distance(in colorX a, in colorX b, ColorProfileAwareOperation option = ColorProfileAwareOperation.UseLinear)
        {
            var colors = ColorProfileHelper.GetOperands(a, b, option);

            return MathX.Distance(colors.leftHand, colors.rightHand);
        }

        public static colorX ConstantLerp(in colorX from, in colorX to, float delta, ColorProfileAwareOperation option = ColorProfileAwareOperation.UseLinear)
        {
             var colors = ColorProfileHelper.GetOperands(from, to, option);

            return new colorX(MathX.ConstantLerp(colors.leftHand, colors.rightHand, delta), colors.profile);
        }

        public static colorX CubicLerp(in colorX from, in colorX fromTangent, in colorX to, in colorX toTangent, float lerp, ColorProfileAwareOperation option = ColorProfileAwareOperation.UseLinear)
        {
            var colors = ColorProfileHelper.GetOperands(from, to, option);

            return new colorX(MathX.CubicLerp(colors.leftHand, fromTangent.ToProfile(colors.profile),
               colors.rightHand, toTangent.ToProfile(colors.profile), lerp), colors.profile);
        }

        public static colorX Slerp(in colorX from, in colorX to, float lerp, ColorProfileAwareOperation option = ColorProfileAwareOperation.UseLinear)
        {
            var colors = ColorProfileHelper.GetOperands(from, to, option);

            return new colorX(MathX.Slerp(colors.leftHand, colors.rightHand, lerp), colors.profile);
        }

        public static colorX SlerpWithMagnitude(in colorX from, in colorX to, float lerp, ColorProfileAwareOperation option = ColorProfileAwareOperation.UseLinear)
        {
            var colors = ColorProfileHelper.GetOperands(from, to, option);

            return new colorX(MathX.SlerpWithMagnitude(colors.leftHand, colors.rightHand, lerp), colors.profile);
        }

        public static colorX Average(in colorX from, in colorX to, ColorProfileAwareOperation option = ColorProfileAwareOperation.UseLinear)
        {
            var colors = ColorProfileHelper.GetOperands(from, to, option);

            return new colorX(MathX.Average(colors.leftHand, colors.rightHand), colors.profile);
        }

        public static colorX Clamp(in colorX value, float min, float max) =>
            new colorX(MathX.Clamp(value.LinearColor, min, max), ColorProfile.Linear);

        public static colorX Clamp(in colorX value, in colorX min, in colorX max) =>
            new colorX(MathX.Clamp(value.baseColor, min.ToProfile(value.profile), max.ToProfile(value.profile)), value.profile);

        public static colorX Clamp01(in colorX value) => new colorX(MathX.Clamp01(value.baseColor), value.Profile);

        public static colorX FilterNaN(in colorX value) => new colorX(MathX.FilterNaN(value.baseColor), value.Profile);

        public static colorX Repeat(in colorX value, float length) => new colorX(MathX.Repeat(value.baseColor, length), value.profile);

        public static colorX PingPong(in colorX value, float length) => new colorX(MathX.PingPong(value.baseColor, length), value.Profile);
        public static colorX PingPong(in colorX value, in colorX length) => new colorX(MathX.PingPong(value.baseColor, length.ToProfile(value.Profile)), value.Profile);
        public static colorX PingPong(float value, in colorX length) => new colorX(MathX.PingPong(value, length.baseColor), length.Profile);

        public static colorX PingPongSafe(in colorX value, float length) => new colorX(MathX.PingPongSafe(value.baseColor, length), value.Profile);
        public static colorX PingPongSafe(in colorX value, in colorX length) => new colorX(MathX.PingPongSafe(value.baseColor, length.ToProfile(value.Profile)), value.Profile);
        public static colorX PingPongSafe(float value, in colorX length) => new colorX(MathX.PingPongSafe(value, length.baseColor), length.Profile);

        public static colorX Round(in colorX value) => new colorX(MathX.Round(value.LinearColor), ColorProfile.Linear);
        public static colorX Ceil(in colorX value) => new colorX(MathX.Ceil(value.LinearColor), ColorProfile.Linear);
        public static colorX Floor(in colorX value) => new colorX(MathX.Floor(value.LinearColor), ColorProfile.Linear);

        public static colorX Pow(in colorX value, float exp) => new colorX(MathX.Pow(value.LinearColor, exp), ColorProfile.Linear);
        public static colorX Pow(in colorX value, in colorX exp) => new colorX(MathX.Pow(value.LinearColor, exp.LinearColor), ColorProfile.Linear);
        public static colorX Pow(float value, in colorX exp) => new colorX(MathX.Pow(value, exp.LinearColor), ColorProfile.Linear);

        public static colorX PowMagnitude(in colorX value, float exp) => new colorX(MathX.PowMagnitude(value.LinearColor, exp), ColorProfile.Linear);

        public static colorX Sign(in colorX value) => new colorX(MathX.Sign(value.baseColor), value.profile);

        public static colorX Sin(in colorX value) => new colorX(MathX.Sin(value.LinearColor), ColorProfile.Linear);
        public static colorX Cos(in colorX value) => new colorX(MathX.Cos(value.LinearColor), ColorProfile.Linear);
        public static colorX Tan(in colorX value) => new colorX(MathX.Tan(value.LinearColor), ColorProfile.Linear);

        public static colorX Asin(in colorX value) => new colorX(MathX.Asin(value.LinearColor), ColorProfile.Linear);
        public static colorX Acos(in colorX value) => new colorX(MathX.Acos(value.LinearColor), ColorProfile.Linear);
        public static colorX Atan(in colorX value) => new colorX(MathX.Atan(value.LinearColor), ColorProfile.Linear);

        public static colorX Atan2(in colorX y, in colorX x) => new colorX(MathX.Atan2(y.LinearColor, x.LinearColor), ColorProfile.Linear);
        public static colorX Atan2(in colorX y, float x) => new colorX(MathX.Atan2(y.LinearColor, x), ColorProfile.Linear);
        public static colorX Atan2(float y, in colorX x) => new colorX(MathX.Atan2(y, x.LinearColor), ColorProfile.Linear);

        public static colorX Sqrt(in colorX value) => new colorX(MathX.Sqrt(value.LinearColor), ColorProfile.Linear);
        public static colorX Exp(in colorX value) => new colorX(MathX.Exp(value.LinearColor), ColorProfile.Linear);

        public static colorX Log(in colorX value) => new colorX(MathX.Log(value.LinearColor), ColorProfile.Linear);
        public static colorX Log10(in colorX value) => new colorX(MathX.Log10(value.LinearColor), ColorProfile.Linear);

        public static colorX Log(in colorX value, in colorX logBase) => new colorX(MathX.Log(value.LinearColor, logBase.LinearColor), ColorProfile.Linear);
        public static colorX Log(in colorX value, float logBase) => new colorX(MathX.Log(value.LinearColor, logBase), ColorProfile.Linear);
        public static colorX Log(float value, in colorX logBase) => new colorX(MathX.Log(value, logBase.LinearColor), ColorProfile.Linear);

        public static color Add(color lhs, color rhs) => lhs + rhs;
        public static color Subtract(color lhs, color rhs) => lhs - rhs;
        public static color Multiply(color lhs, color rhs) => lhs * rhs;
        public static color Divide(color lhs, color rhs) => lhs / rhs;
        public static color Modulus(color lhs, color rhs) => lhs % rhs;

		<#
		var dualParamFunctions = new string[] { "Min", "Max", "Repeat", "Add", "Subtract", "Multiply", "Divide", "Modulus" };

		foreach(var f in dualParamFunctions)
		{
			#>
			public static colorX <#=f#>(in colorX a, in colorX b, ColorProfileAwareOperation option = ColorProfileAwareOperation.LinearIfUnequal)
			{
				var colors = ColorProfileHelper.GetOperands(a, b, option);

				return new colorX(<#=f#>(colors.leftHand, colors.rightHand), colors.profile);
			}
			<#
		}
		#>

		public static colorX Abs(in colorX n) => new colorX(Abs(n.baseColor), n.profile);

		public static colorX FilterInvalid(in colorX n) => new colorX(FilterInvalid(n.baseColor), n.profile);

		public static bool Approximately(in colorX a, in colorX b)
		{
			if(a.profile == b.profile)
				return Approximately(a.baseColor, b.baseColor);
			else
				return Approximately(a.LinearColor, b.LinearColor);
		}

		public static bool IsBetween(in colorX n, in colorX min, in colorX max)
		{
			if(n.profile == min.profile && min.profile == max.profile)
				return IsBetween(n.baseColor, min.baseColor, max.baseColor);
			else
				return IsBetween(n.LinearColor, min.LinearColor, max.LinearColor);
		}

        public static colorX BezierCurve(in colorX from, in colorX to, in colorX fromTangent, in colorX toTangent, float t)
        {
            var _from = from.LinearColor;
            var _to = to.LinearColor;
            var _fromTan = fromTangent.LinearColor;
            var _toTan = toTangent.LinearColor;

            var u = 1f - t;
            var tt = t * t;
            var uu = u * u;
            var ttt = tt * t;
            var uuu = uu * u;

            return new colorX(
                uuu * _from +
                (3 * uu * t * _fromTan) +
                (3 * u * tt * _toTan) +
                ttt * _to, ColorProfile.Linear);
        }

        public static colorX BezierTangent(in colorX from, in colorX to, in colorX fromTangent, in colorX toTangent, float t)
        {
            var _from = from.LinearColor;
            var _to = to.LinearColor;
            var _fromTan = fromTangent.LinearColor;
            var _toTan = toTangent.LinearColor;

            return new colorX(
                -3f * MathX.Pow(1f - t, 2f) * _from +
                3f * MathX.Pow(1f - t, 2f) * _fromTan -
                6f * t * (1f - t) * _fromTan -
                3f * MathX.Pow(t, 2f) * _toTan +
                6f * t * (1f - t) * _toTan +
                3f * MathX.Pow(t, 2f) * _to, ColorProfile.Linear);
        }
    }
}
