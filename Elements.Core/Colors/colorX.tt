		public static colorX Parse(string s, NumberStyles style, IFormatProvider provider)
		{
			var nums = PrimitivesUtility.ExtractElements(s, 5);
			ColorProfile profile = ColorProfile.sRGB;

			if (nums == null)
				nums = PrimitivesUtility.ExtractElements(s, 4);

			if (nums.Length == 5)
				profile = (ColorProfile)Enum.Parse(typeof(ColorProfile), nums[4]);

			return new colorX(float.Parse(nums[0], style, provider),
				float.Parse(nums[1], style, provider),
				float.Parse(nums[2], style, provider),
				float.Parse(nums[3], style, provider), profile);
		}

		public static bool TryParse(string s, out colorX val) => TryParse(s, NumberStyles.Float, CultureInfo.InvariantCulture, out val);

		public static bool TryParse(string s, NumberStyles style, IFormatProvider provider, out colorX val)
		{
			var nums = PrimitivesUtility.ExtractElements(s, 5);

			ColorProfile profile = ColorProfile.sRGB;

			if (nums == null)
				nums = PrimitivesUtility.ExtractElements(s, 4);

			if(nums == null)
			{
				val = default;
				return false;
			}

			if (nums.Length == 5)
			{
				if(!Enum.TryParse(nums[4], out profile))
				{
					val = default;
					return false;
				}
			}

			var parsed_x = float.TryParse(nums[0], style, provider, out float x);
			var parsed_y = float.TryParse(nums[1], style, provider, out float y);
			var parsed_z = float.TryParse(nums[2], style, provider, out float z);
			var parsed_w = float.TryParse(nums[3], style, provider, out float w);

			if(parsed_x && parsed_y && parsed_z && parsed_w)
			{
				val = new colorX(x, y, z, w, profile);
				return true;
			}

			val = default;
			return false;
		}

