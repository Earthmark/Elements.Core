	public readonly string ToHexString(bool alpha = false, string prefix = "#")
	{
		byte _r = (byte)MathX.Clamp((int)(r*255), 0, 256);
		byte _g = (byte)MathX.Clamp((int)(g*255), 0, 256);
		byte _b = (byte)MathX.Clamp((int)(b*255), 0, 256);
		byte _a = (byte)MathX.Clamp((int)(a*255), 0, 256);

		return prefix + _r.ToString("X2") + _g.ToString("X2") + _b.ToString("X2")
			+ (alpha ? _a.ToString("X2") : "");
	}

	public readonly string ToShortHexString(bool alpha = false, string prefix = "#")
	{
		byte _r = (byte)MathX.Clamp((int)(r*16), 0, 16);
		byte _g = (byte)MathX.Clamp((int)(g*16), 0, 16);
		byte _b = (byte)MathX.Clamp((int)(b*16), 0, 16);
		byte _a = (byte)MathX.Clamp((int)(a*16), 0, 16);

		return prefix + _r.ToString("X1") + _g.ToString("X1") + _b.ToString("X1")
			+ (alpha ? _a.ToString("X1") : "");
	}

