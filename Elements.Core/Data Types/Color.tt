public static partial class MathX
{
    
    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public static color Lerp(in color a, in color b, float lerp)
    {
        if (lerp <= 0)
            return a;

        if (lerp >= 1f)
            return b;

        return LerpUnclamped(a, b, lerp);
    }

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public static color LerpUnclamped(in color a, in color b, float lerp)
    {
        float ak = 1 - lerp;
        float bk = lerp;

        return new color(
            a.r * ak + b.r * bk,
            a.g * ak + b.g * bk,
            a.b * ak + b.b * bk,
            a.a * ak + b.a * bk);

    }
}

