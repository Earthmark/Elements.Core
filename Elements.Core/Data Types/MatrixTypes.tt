		// Casting

		<#
        if(basetype == "float" && r == 4 && c == 4)
        {
            #>

            public static implicit operator RenderMatrix4x4(in <#=matrixtype#> m)
            {
            	return new RenderMatrix4x4(<#=
				    H.FormatList(e=>"m." + e, ",\n\t\t\t", elements.ToArray())#>
                );
            }

            <#
        }

		string declaration;
		string casttype;
		string castbase;

		if(basetype == "float")
		{
			declaration = "implicit";
			castbase = "double";
			casttype = "double" + sizename;
		}
		else
		{
			declaration = "explicit";
			castbase = "float";
			casttype = "float" + sizename;
		}
		#>

		[MethodImpl(MethodImplOptions.AggressiveInlining)]
		public static <#=declaration#> operator <#=casttype#>(in <#=matrixtype#> m)
		{
			return new <#=casttype#>(<#=
				H.FormatList(e=>"("+castbase+")m." + e, ",\n\t\t\t", elements.ToArray())#>);
		}

		// downcasting

		<#
		if(c == r)
		for(int s = 2; s <= 4; s++)
		{
			if(s == c)
				continue;

			var downcast = basetype + s + "x" + s;

			var dr = Math.Min(s, r);
			var dc = Math.Min(s, c);

			#>

			[MethodImpl(MethodImplOptions.AggressiveInlining)]
			public static explicit operator <#=downcast#>(in <#=matrixtype#> m)
			{
				return new <#=downcast#>(
					<#for(int _r = 0; _r < dr; _r++)
						for(int _c = 0; _c < dc; _c++)
						{
							#>m<#=_r + "" + _c#>: m.m<#=_r + "" + _c#><#
							if(_r < dr-1 || _c < dc-1) { #>, <# } 
						}#>
				);
			}
			
			<#
		}
		#>

		#endregion

		#region VECTOR OPERATIONS

		[MethodImpl(MethodImplOptions.AggressiveInlining)]
		public static <#=basetype + r#> operator *(in <#=matrixtype#> m, in <#=basetype + r#> v)
		{
			<#
				code = "";
				
				for(int _r = 0; _r < r; _r++)
				{
					for(int _c = 0; _c < c; _c++)
					{
						code += "m.m" + _r + _c + "*v." + Config.VectorElements[_c];
						if(_c != c-1)
							code += "+";
					}

					if(_r != r-1)
						code += " , ";
				}
			#>

			return new <#=basetype + r#>(<#=code#>);
		}

		<#if(r > 2)
		{
			#>

			[MethodImpl(MethodImplOptions.AggressiveInlining)]
			public static <#=basetype + (r-1)#> operator *(in <#=matrixtype#> m, in <#=basetype + (r-1)#> v)
			{
				<#
				string _els = Config.VectorElements.Substring(0, r-1);
				#>

				var result = (m * (new <#=basetype + r#>(v.<#=_els#>, 1)));
				return result.<#=_els#> / result.<#=Config.VectorElements[r-1]#>;
			}

			<#
		}
		#>

        <#if(r >= 3 && c >= 3)
        {
            #>
            public readonly <#=basetype#>3 TransformVector(in <#=basetype#>3 vector)
			{
				return new <#=basetype#>3(<#=GenMatrixVectorMul(3, 3, 3, "vector")#>);
			}

            public readonly <#=basetype#> TransformScale(<#=basetype#> scale) =>
                TransformVector(scale * <#=basetype#>3.UnitDiagonal).Magnitude;

			public readonly <#=basetype#>3 TransformDirection(in <#=basetype#>3 direction)
			{
				return TransformVector(direction).Normalized * direction.Magnitude;
			}
            <#
        }#>

		<#
		if(r == 4 && c == 4)
		{
			#>

			public readonly <#=basetype#>3 TransformPoint(in <#=basetype#>3 point)
			{
				return this * point;
			}

			public readonly <#=basetype#>3 TransformPoint3x4(in <#=basetype#>3 point)
			{
				return new <#=basetype#>3(<#=GenMatrixVectorMul(4, 3, 3, "point")#>);
			}

			public readonly <#=basetype#>3x3 TransformMatrix3x3(in <#=basetype#>3x3 matrix)
			{
				<#
				code = "";
			
				for(int _r = 0; _r < 3; _r++)
				{
					for(int _c = 0; _c < 3; _c++)
					{
						for(int i = 0; i < 3; i++)
						{
							code += "m" + _r + "" + i + "*" + "matrix.m" + i + "" + _c;
							if(i < 3-1)
								code += " + ";
						}

						if(_r < 3-1 || _c < 3-1)
							code += ",";

						code += "\n\t\t\t\t";		
					}
				}
				#>

				return new <#=basetype#>3x3(
					<#=code#>);
			}

			public readonly <#=basetype#>Q TransformQuaternion(<#=basetype#>Q q)
			{
				return TransformMatrix3x3(<#=basetype#>3x3.Rotation(q)).DecomposedRotation;
			}

			public static void MultiplyAffineFast(ref <#=matrixtype#> a, ref <#=matrixtype#> b, out <#=matrixtype#> y)
			{
				<#
					code = "";
			
					for(int _r = 0; _r < 4; _r++)
					{
						for(int _c = 0; _c < 4; _c++)
						{
							if(_r < 3 && _c < 3)
							{
								for(int i = 0; i < 3; i++)
								{
									code += "a.m" + _r + "" + i + "*" + "b.m" + i + "" + _c;
									if(i < 3-1)
										code += " + ";
								}
							}
							else if(_r < 3)
							{
								code += "a.mR0*b.m03 + a.mR1*b.m13 + a.mR2*b.m23 + a.mR3".Replace("R", _r.ToString());
							}
							else
								code += (_c == 3) ? "1" : "0";

							if(_r < 4-1 || _c < 4-1)
								code += ",";

							code += "\n\t\t\t\t";		
						}
					}
					#>

					y = new <#=basetype#>4x4(
						<#=code#>);
			}

			public readonly <#=matrixtype#> MultiplyAffineFast(in <#=matrixtype#> matrix)
			{
				<#
				code = "";
			
				for(int _r = 0; _r < 4; _r++)
				{
					for(int _c = 0; _c < 4; _c++)
					{
						if(_r < 3 && _c < 3)
						{
							for(int i = 0; i < 3; i++)
							{
								code += "m" + _r + "" + i + "*" + "matrix.m" + i + "" + _c;
								if(i < 3-1)
									code += " + ";
							}
						}
						else if(_r < 3)
						{
							code += "mR0*matrix.m03 + mR1*matrix.m13 + mR2*matrix.m23 + mR3".Replace("R", _r.ToString());
						}
						else
							code += (_c == 3) ? "1" : "0";

						if(_r < 4-1 || _c < 4-1)
							code += ",";

						code += "\n\t\t\t\t";		
					}
				}
				#>

				return new <#=basetype#>4x4(
					<#=code#>);
			}

			<#
		}
		#>

		#endregion

		#region CONVERSIONS/CASTS


		#endregion
	}	

	public static partial class MathX
	{
		[MethodImpl(MethodImplOptions.AggressiveInlining)]
		public static <#=matrixtype#> Lerp(in <#=matrixtype#> a, in <#=matrixtype#> b, float lerp)
		{
			if(lerp <= 0)
				return a;
			if(lerp >= 1)
				return b;

			return LerpUnclamped(a, b, lerp);
		}

		[MethodImpl(MethodImplOptions.AggressiveInlining)]
		public static <#=matrixtype#> LerpUnclamped(in <#=matrixtype#> a, in <#=matrixtype#> b, float lerp)
		{
			return a + (b - a) * lerp;
		}

        [MethodImpl(MethodImplOptions.AggressiveInlining)]
		public static <#=matrixtype#> ConstantLerp(in <#=matrixtype#> a, in <#=matrixtype#> b, float delta)
		{
            // TODO!!! This just applies constant lerp individually to each element, so it's done element-wise
            // Should there be a different variant where it computes distance in the multidimensional space and
            // lerps each component appropriately?
			return new <#=matrixtype#>(
				<#=H.FormatList(e=> $"ConstantLerp(a.{e}, b.{e}, delta)", ",\n\t\t\t\t", elements.ToArray())#>);
		}

        <#if(basetype != "float")
        {
            #>

            [MethodImpl(MethodImplOptions.AggressiveInlining)]
		    public static <#=matrixtype#> Lerp(in <#=matrixtype#> a, in <#=matrixtype#> b, <#=basetype#> lerp)
		    {
			    if(lerp <= 0)
				    return a;
			    if(lerp >= 1)
				    return b;

			    return LerpUnclamped(a, b, lerp);
		    }

		    [MethodImpl(MethodImplOptions.AggressiveInlining)]
		    public static <#=matrixtype#> LerpUnclamped(in <#=matrixtype#> a, in <#=matrixtype#> b, <#=basetype#> lerp)
		    {
			    return a + (b - a) * lerp;
		    }

            <#
        }#>

		[MethodImpl(MethodImplOptions.AggressiveInlining)]
		public static bool Approximately(in <#=matrixtype#> a, in <#=matrixtype#> b)
		{
			return <#=H.FormatList(e=>$"Approximately(a.{e}, b.{e})", " && \n\t\t\t\t", elements.ToArray())#>;
		}

		[MethodImpl(MethodImplOptions.AggressiveInlining)]
		public static bool Approximately(in <#=matrixtype#> a, in <#=matrixtype#> b, <#=basetype#> epsilon)
		{
			return <#=H.FormatList(e=>$"Approximately(a.{e}, b.{e}, epsilon)", " && \n\t\t\t\t", elements.ToArray())#>;
		}

		[MethodImpl(MethodImplOptions.AggressiveInlining)]
		public static <#=matrixtype#> Abs(in <#=matrixtype#> v)
		{
			return new <#=matrixtype#>(
				<#=H.FormatList(e=>"Abs(v."+e+")", ",\n\t\t\t\t", elements.ToArray())#>
			);
		}

		[MethodImpl(MethodImplOptions.AggressiveInlining)]
		public static <#=matrixtype#> Round(in <#=matrixtype#> v)
		{
			return new <#=matrixtype#>(
				<#=H.FormatList(e=>"Round(v."+e+")", ",\n\t\t\t\t", elements.ToArray())#>
			);
		}

        [MethodImpl(MethodImplOptions.AggressiveInlining)]
		public static <#=matrixtype#> FilterInvalid(in <#=matrixtype#> v, in <#=matrixtype#> fallback = default)
		{
			if(v.IsNaN || v.IsInfinity)
                return fallback;

            return v;
		}

        public static <#=matrixtype#> BezierCurve(in <#=matrixtype#> from, in <#=matrixtype#> to, in <#=matrixtype#> fromTangent, in <#=matrixtype#> toTangent, float t)
        {
            var u = 1f - t;
            var tt = t * t;
            var uu = u * u;
            var ttt = tt * t;
            var uuu = uu * u;

            return uuu * from +
                (3 * uu * t * fromTangent) +
                (3 * u * tt * toTangent) +
                ttt * to;
        }

        public static <#=matrixtype#> BezierTangent(in <#=matrixtype#> from, in <#=matrixtype#> to, in <#=matrixtype#> fromTangent, in <#=matrixtype#> toTangent, float t)
        {
            return -3f * MathX.Pow(1f - t, 2f) * from +
                3f * MathX.Pow(1f - t, 2f) * fromTangent -
                6f * t * (1f - t) * fromTangent -
                3f * MathX.Pow(t, 2f) * toTangent +
                6f * t * (1f - t) * toTangent +
                3f * MathX.Pow(t, 2f) * to;
        }
	}

	public static class <#= H.Capitalize(matrixtype) + "Extensions" #>
	{
		// BinaryReader/Writer extension

		public static void Write(this BinaryWriter bw, in <#=matrixtype#> m)
		{
			<#
			foreach(var el in elements)
			{
				#>
				bw.Write(m.<#=el#>);
				<#
			}
			#>
		}

		public static <#=matrixtype#> Read<#=typeinfo.BinaryReaderName#>(this BinaryReader br)
		{
			return new <#=matrixtype#>(<#=H.FormatList(r*c, "br.Read" + 
				typeinfo.BaseType.BinaryReaderName + "()", ",\n\t\t\t\t")#>);
		}
	}

	<#
}
#>

}

<#+

string GenMatrixVectorMul(int columns, int rows, int vectordim, string vector = "v") =>
    GenMatrixVectorMulRaw(columns, rows, vectordim, vector + ".#", ",");

string GenMatrixVectorMulRaw(int columns, int rows, int vectordim, string vector = "v.#", string rowSeparator = ",")
{
	var code = "";

	for(int _r = 0; _r < rows; _r++)
	{
		for(int _c = 0; _c < columns; _c++)
		{
			if(_c < vectordim)
				code += "m" + _r + _c + "*" + vector.Replace("#", Config.VectorElements[_c].ToString());
			else
				code += "m" + _r + _c;

			if(_c < columns-1)
				code += " + ";
		}

		if(_r != rows-1)
			code += rowSeparator + "\n\t\t\t\t\t\t";
	}

	return code;
}

#>
