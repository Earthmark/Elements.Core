		<#
		// Only generate this multiplication method if it's a square matrix
		if(r==c)
		{
		#>

		[MethodImpl(MethodImplOptions.AggressiveInlining)]
		public static <#=matrixtype#> operator *(in <#=matrixtype#> a, in <#=matrixtype#> b)
		{
			<#
			code = "";
			
			for(int _r = 0; _r < r; _r++)
			{
				for(int _c = 0; _c < c; _c++)
				{
					for(int i = 0; i < r; i++)
					{
						code += "a.m" + _r + "" + i + "*" + "b.m" + i + "" + _c;
						if(i < r-1)
							code += " + ";
					}

					if(_r < r-1 || _c < c-1)
						code += ",";

					code += "\n\t\t\t\t";		
				}
			}
			#>

			return new <#=matrixtype#>(
				<#=code#>);
		}

		[MethodImpl(MethodImplOptions.AggressiveInlining)]
		public static void Multiply(in <#=matrixtype#> a, in <#=matrixtype#> b, ref <#=matrixtype#> result)
		{
			<#
			code = "";
			
			for(int _r = 0; _r < r; _r++)
			{
				for(int _c = 0; _c < c; _c++)
				{
					for(int i = 0; i < r; i++)
					{
						code += "a.m" + _r + "" + i + "*" + "b.m" + i + "" + _c;
						if(i < r-1)
							code += " + ";
					}

					if(_r < r-1 || _c < c-1)
						code += ",";

					code += "\n\t\t\t\t";		
				}
			}
			#>

			result = new <#=matrixtype#>(
				<#=code#>);
		}

		<#
		}
