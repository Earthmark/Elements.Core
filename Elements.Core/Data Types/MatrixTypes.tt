		#region FORMATTING AND PARSING

		public override string ToString()
		{
			return this.ToString(System.Globalization.CultureInfo.InvariantCulture);
		}

		public readonly string ToString(IFormatProvider provider)
		{
			var str = new StringBuilder();

			str.Append("[");

			for(int r = 0; r < Rows; r++)
			{
				for(int c = 0; c < Columns; c++)
				{
					str.Append(this[r,c].ToString(provider));
					if(r != Rows-1 || c != Columns-1)
						str.Append("; ");
				}

				if(r != Rows-1)
				{
					str.AppendLine();
					str.Append(" ");
				}
				else
					str.AppendLine("]");								
			}

			return str.ToString();
		}

		public readonly string ToString(string elementFormat)
		{
			var str = new StringBuilder();

			str.Append("[");

			for(int r = 0; r < Rows; r++)
			{
				for(int c = 0; c < Columns; c++)
				{
					str.Append(this[r,c].ToString(elementFormat));
					if(r != Rows-1 || c != Columns-1)
						str.Append("; ");
				}

				if(r != Rows-1)
				{
					str.AppendLine();
					str.Append(" ");
				}
				else
					str.AppendLine("]");								
			}

			return str.ToString();
		}

		public readonly string ToString(string elementFormat, IFormatProvider provider)
		{
			var str = new StringBuilder();

			str.Append("[");

			for(int r = 0; r < Rows; r++)
			{
				for(int c = 0; c < Columns; c++)
				{
					str.Append(this[r,c].ToString(elementFormat, provider));
					if(r != Rows-1 || c != Columns-1)
						str.Append("; ");
				}

				if(r != Rows-1)
				{
					str.AppendLine();
					str.Append(" ");
				}
				else
					str.AppendLine("]");								
			}

			return str.ToString();
		}

		public static <#=matrixtype#> Parse(string s)
		{
			var nums = PrimitivesUtility.ExtractElements(s, <#=values#>);

			return new <#=matrixtype#>(<#=H.FormatList((e,i)=>
				basetype + ".Parse(nums[" + i + "])", ",", elements.ToArray())#>);
		}

		public static <#=matrixtype#> Parse(string s, IFormatProvider provider)
		{
			var nums = PrimitivesUtility.ExtractElements(s, <#=values#>);

			return new <#=matrixtype#>(<#=H.FormatList((e,i)=>
				basetype + ".Parse(nums[" + i + "], provider)", ",", elements.ToArray())#>);
		}

		public static <#=matrixtype#> Parse(string s, NumberStyles style)
		{
			var nums = PrimitivesUtility.ExtractElements(s, <#=values#>);

			return new <#=matrixtype#>(<#=H.FormatList((e,i)=>
				basetype + ".Parse(nums[" + i + "], style)", ",", elements.ToArray())#>);
		}

		public static <#=matrixtype#> Parse(string s, NumberStyles style, IFormatProvider provider)
		{
			var nums = PrimitivesUtility.ExtractElements(s, <#=values#>);

			return new <#=matrixtype#>(<#=H.FormatList((e,i)=>
				basetype + ".Parse(nums[" + i + "], style, provider)", ",", elements.ToArray())#>);
		}

        public static bool TryParse(string s, out <#=matrixtype#> val)
        {
            return TryParse(s, NumberStyles.Float, null, out val);
        }

        public static bool TryParse(string s, NumberStyles numberStyles, IFormatProvider formatProvider, out <#=matrixtype#> val)
	    {
            var nums = PrimitivesUtility.ExtractElements(s, <#=values#>);

			if(nums == null)
			{
				val = default;
				return false;
			}

            <#=H.FormatList((e,i)=>$"var parsed_{e} = {basetype}.TryParse(nums[{i}], numberStyles, formatProvider, out {basetype} {e});",
                "\n\t\t", elements.ToArray())#>         

            if(<#=H.FormatList((e,i)=>$"parsed_{e}", " && ", elements.ToArray())#>)
            {
                val = new <#=matrixtype#>(<#=H.FormatList((e,i)=>e, ",", elements.ToArray())#>);
                return true;
            }

            val = default;
            return false;
	    }

