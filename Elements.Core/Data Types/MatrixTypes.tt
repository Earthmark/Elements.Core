		<#if(c==r && (c==4 || c==3))
		{
			#>

			// sadly not a generic algorithm for computing determinant and inverse for now
			// just copied formulas
			// if I have time in the future, I'll make one (or for the generic Matrix type)

			<#if(c==4)
			{
			#>
			public readonly <#=basetype#> Determinant
			{
				get
				{
					var b0 = (m20 * m31) - (m21 * m30);
					var b1 = (m20 * m32) - (m22 * m30);
					var b2 = (m23 * m30) - (m20 * m33);
					var b3 = (m21 * m32) - (m22 * m31);
					var b4 = (m23 * m31) - (m21 * m33);
					var b5 = (m22 * m33) - (m23 * m32);

					var d00 = m11 * b5 + m12 * b4 + m13 * b3;
					var d01 = m10 * b5 + m12 * b2 + m13 * b1;
					var d02 = m10 * -b4 + m11 * b2 + m13 * b0;
					var d03 = m10 * b3 + m11 * -b1 + m12 * b0;

					return m00 * d00 - m01 * d01 + m02 * d02 - m03 * d03;
				}
			}

			public readonly <#=basetype#> Determinant3x3
			{
				get
				{
					return 
						m00 * (m11*m22 - m12*m21) -
						m01 * (m10*m22 - m12*m20) +
						m02 * (m10*m21 - m11*m20);
				}
			}

			public readonly <#=matrixtype#> Inverse
			{
				get
				{
					var b0 = (m20 * m31) - (m21 * m30);
					var b1 = (m20 * m32) - (m22 * m30);
					var b2 = (m23 * m30) - (m20 * m33);
					var b3 = (m21 * m32) - (m22 * m31);
					var b4 = (m23 * m31) - (m21 * m33);
					var b5 = (m22 * m33) - (m23 * m32);

					var d00 = m11 * b5 + m12 * b4 + m13 * b3;
					var d01 = m10 * b5 + m12 * b2 + m13 * b1;
					var d02 = m10 * -b4 + m11 * b2 + m13 * b0;
					var d03 = m10 * b3 + m11 * -b1 + m12 * b0;

					var det = m00 * d00 - m01 * d01 + m02 * d02 - m03 * d03;
					if (det == 0)
						return <#=matrixtype#>.Zero;

					det = 1 / det;

					var a0 = (m00 * m11) - (m01 * m10);
					var a1 = (m00 * m12) - (m02 * m10);
					var a2 = (m03 * m10) - (m00 * m13);
					var a3 = (m01 * m12) - (m02 * m11);
					var a4 = (m03 * m11) - (m01 * m13);
					var a5 = (m02 * m13) - (m03 * m12);

					var d10 = m01 * b5 + m02 * b4 + m03 * b3;
					var d11 = m00 * b5 + m02 * b2 + m03 * b1;
					var d12 = m00 * -b4 + m01 * b2 + m03 * b0;
					var d13 = m00 * b3 + m01 * -b1 + m02 * b0;

					var d20 = m31 * a5 + m32 * a4 + m33 * a3;
					var d21 = m30 * a5 + m32 * a2 + m33 * a1;
					var d22 = m30 * -a4 + m31 * a2 + m33 * a0;
					var d23 = m30 * a3 + m31 * -a1 + m32 * a0;

					var d30 = m21 * a5 + m22 * a4 + m23 * a3;
					var d31 = m20 * a5 + m22 * a2 + m23 * a1;
					var d32 = m20 * -a4 + m21 * a2 + m23 * a0;
					var d33 = m20 * a3 + m21 * -a1 + m22 * a0;

					return new <#=matrixtype#>(
						+d00, -d10, +d20, -d30,
						-d01, +d11, -d21, +d31,
						+d02, -d12, +d22, -d32,
						-d03, +d13, -d23, +d33) * det;
				}
			}

			public static void SetAffineInverseFast(ref <#=matrixtype#> matrix, out <#=matrixtype#> inverse)
			{
					var det = matrix.Determinant3x3;

					if(det == 0)
					{
						inverse = default;
						return;
					}

					det = 1 / det;

					var _m00 = (matrix.m11 * matrix.m22 - matrix.m12 * matrix.m21) * det;
					var _m01 = (matrix.m02 * matrix.m21 - matrix.m22 * matrix.m01) * det;
					var _m02 = (matrix.m01 * matrix.m12 - matrix.m11 * matrix.m02) * det;

					var _m10 = (matrix.m12 * matrix.m20 - matrix.m10 * matrix.m22) * det;
					var _m11 = (matrix.m00 * matrix.m22 - matrix.m02 * matrix.m20) * det;
					var _m12 = (matrix.m02 * matrix.m10 - matrix.m00 * matrix.m12) * det;

					var _m20 = (matrix.m10 * matrix.m21 - matrix.m11 * matrix.m20) * det;
					var _m21 = (matrix.m01 * matrix.m20 - matrix.m00 * matrix.m21) * det;
					var _m22 = (matrix.m00 * matrix.m11 - matrix.m01 * matrix.m10) * det;

					inverse = new <#=matrixtype#>(
						_m00, _m01, _m02, -(_m00*matrix.m03 + _m01*matrix.m13 + _m02*matrix.m23),
						_m10, _m11, _m12, -(_m10*matrix.m03 + _m11*matrix.m13 + _m12*matrix.m23),
						_m20, _m21, _m22, -(_m20*matrix.m03 + _m21*matrix.m13 + _m22*matrix.m23),
						0, 0, 0, 1
					);
			}

			public readonly <#=matrixtype#> AffineInverseFast
			{
				get
				{
					var det = Determinant3x3;

					if(det == 0)
						return <#=matrixtype#>.Zero;

					det = 1 / det;

					var _m00 = (m11 * m22 - m12 * m21) * det;
					var _m01 = (m02 * m21 - m22 * m01) * det;
					var _m02 = (m01 * m12 - m11 * m02) * det;

					var _m10 = (m12 * m20 - m10 * m22) * det;
					var _m11 = (m00 * m22 - m02 * m20) * det;
					var _m12 = (m02 * m10 - m00 * m12) * det;

					var _m20 = (m10 * m21 - m11 * m20) * det;
					var _m21 = (m01 * m20 - m00 * m21) * det;
					var _m22 = (m00 * m11 - m01 * m10) * det;

					return new <#=matrixtype#>(
						_m00, _m01, _m02, -(_m00*m03 + _m01*m13 + _m02*m23),
						_m10, _m11, _m12, -(_m10*m03 + _m11*m13 + _m12*m23),
						_m20, _m21, _m22, -(_m20*m03 + _m21*m13 + _m22*m23),
						0, 0, 0, 1
					);
				}
			}

			[MethodImpl(MethodImplOptions.AggressiveInlining)]
			public static <#=matrixtype#> Translation(in <#=basetype#>3 v)
			{
				return new <#=matrixtype#>(

					m00: 1,
					m11: 1,
					m22: 1,
					m33: 1,

					m03: v.x,
					m13: v.y,
					m23: v.z
					);
			}

			[MethodImpl(MethodImplOptions.AggressiveInlining)]
			public static void SetTransform(in <#=basetype#>3 position, in <#=basetype#>Q rotation, in <#=basetype#>3 scale,
				out <#=matrixtype#> matrix)
			{
				var x = rotation.x;
				var y = rotation.y;
				var z = rotation.z;
				var w = rotation.w;

				var xx = 2*x*x;
				var yy = 2*y*y;
				var zz = 2*z*z;

				var xy = 2*x*y;
				var wz = 2*w*z;
				var xz = 2*x*z;
				var wy = 2*w*y;
				var yz = 2*y*z;
				var wx = 2*w*x;

				var sx = scale.x;
				var sy = scale.y;
				var sz = scale.z;

				matrix = new <#=matrixtype#>(
					sx*(1-yy-zz),	sy*(xy-wz),	sz*(xz+wy),	position.x,
					sx*(xy+wz),	sy*(1-xx-zz),	sz*(yz-wx),	position.y,
					sx*(xz-wy),	sy*(yz+wx),	sz*(1-xx-yy),	position.z,
					0, 0, 0, 1
				);

				// Unoptimized:
				/*return new <#=matrixtype#>(
					sx*(1-2*yy-2*zz),	sy*(2*x*y-2*w*z),	sz*(2*x*z+2*w*y),	position.x,
					sx*(2*x*y+2*w*z),	sy*(1-2*xx-2*zz),	sz*(2*y*z-2*w*x),	position.y,
					sx*(2*x*z-2*w*y),	sy*(2*y*z+2*w*x),	sz*(1-2*xx-2*yy),	position.z,
					0, 0, 0, 1
				);*/
			}

			[MethodImpl(MethodImplOptions.AggressiveInlining)]
			public static <#=matrixtype#> Transform(in <#=basetype#>3 position, in <#=basetype#>Q rotation, in <#=basetype#>3 scale)
			{
				var x = rotation.x;
				var y = rotation.y;
				var z = rotation.z;
				var w = rotation.w;

				var xx = 2*x*x;
				var yy = 2*y*y;
				var zz = 2*z*z;

				var xy = 2*x*y;
				var wz = 2*w*z;
				var xz = 2*x*z;
				var wy = 2*w*y;
				var yz = 2*y*z;
				var wx = 2*w*x;

				var sx = scale.x;
				var sy = scale.y;
				var sz = scale.z;

				return new <#=matrixtype#>(
					sx*(1-yy-zz),	sy*(xy-wz),	sz*(xz+wy),	position.x,
					sx*(xy+wz),	sy*(1-xx-zz),	sz*(yz-wx),	position.y,
					sx*(xz-wy),	sy*(yz+wx),	sz*(1-xx-yy),	position.z,
					0, 0, 0, 1
				);

				// Unoptimized:
				/*return new <#=matrixtype#>(
					sx*(1-2*yy-2*zz),	sy*(2*x*y-2*w*z),	sz*(2*x*z+2*w*y),	position.x,
					sx*(2*x*y+2*w*z),	sy*(1-2*xx-2*zz),	sz*(2*y*z-2*w*x),	position.y,
					sx*(2*x*z-2*w*y),	sy*(2*y*z+2*w*x),	sz*(1-2*xx-2*yy),	position.z,
					0, 0, 0, 1
				);*/
			}

			public readonly <#=basetype#>3 DecomposedPosition => new <#=basetype#>3(m03, m13, m23);

			public readonly void Decompose(out <#=basetype#>3 position, out <#=basetype#>Q rotation, out <#=basetype#>3 scale)
			{
				position = new <#=basetype#>3(m03, m13, m23);

				scale = new <#=basetype#>3(
						MathX.Sqrt(m00*m00 + m10*m10 + m20*m20) /** MathX.Sign(<#if(c==4){#>Determinant3x3<#}else{#>Determinant<#}#>)*/,
						MathX.Sqrt(m01*m01 + m11*m11 + m21*m21),
						MathX.Sqrt(m02*m02 + m12*m12 + m22*m22)
						);

				var invScale = 1 / scale;

				//var m0 = new <#=basetype#>3(m00, m10, m20) * invScale.x;
				var m1 = new <#=basetype#>3(m01, m11, m21) * invScale.y;
				var m2 = new <#=basetype#>3(m02, m12, m22) * invScale.z;

				var m0 = MathX.Cross(m1, m2);

				var r0 = m0.x + m1.y + m2.z;

				<#=basetype#> x, y, z, w;

				if (r0 > 0)
				{
					var r1 = MathX.Sqrt(r0 + 1f);
					w = r1 * 0.5f;
					r1 = 0.5f / r1;
					x = (m1.z - m2.y) * r1;
					y = (m2.x - m0.z) * r1;
					z = (m0.y - m1.x) * r1;
				}
				else if((m0.x >= m1.y) && (m0.x >= m2.z))
				{
					var r1 = MathX.Sqrt(((1f + m0.x) - m1.y) - m2.z);
					var r2 = 0.5f / r1;
					x = 0.5f * r1;
					y = (m0.y + m1.x) * r2;
					z = (m0.z + m2.x) * r2;
					w = (m1.z - m2.y) * r2;
				}
				else if (m1.y > m2.z)
				{
					var r1 = MathX.Sqrt(((1f + m1.y) - m0.x) - m2.z);
					var r2 = 0.5f / r1;
					x = (m1.x + m0.y) * r2;
					y = 0.5f * r1;
					z = (m2.y + m1.z) * r2;
					w = (m2.x - m0.z) * r2;
				}
				else
				{
					var r1 = MathX.Sqrt(((1f + m2.z) - m0.x) - m1.y);
					var r2 = 0.5f / r1;
					x = (m2.x + m0.z) * r2;
					y = (m2.y + m1.z) * r2;
					z = 0.5f * r1;
					w = (m0.y - m1.x) * r2;
				}

				rotation = new <#=basetype#>Q(x,y,z,w);
			}

			<#} // end of "if 4x4" #>

			<#if(c==3)
			{
			#>

			public readonly <#=basetype#> Determinant
			{
				get
				{
					return 
						m00 * (m11*m22 - m12*m21) -
						m01 * (m10*m22 - m12*m20) +
						m02 * (m10*m21 - m11*m20);
				}
			}


			public readonly <#=matrixtype#> Inverse
			{
				get
				{
					var det = Determinant;

					if(det == 0)
						return <#=matrixtype#>.Zero;

					det = 1 / det;

					return new <#=matrixtype#>(
						m00: (m11 * m22 - m12 * m21) * det,
						m01: (m02 * m21 - m22 * m01) * det,
						m02: (m01 * m12 - m11 * m02) * det,

						m10: (m12 * m20 - m10 * m22) * det,
						m11: (m00 * m22 - m02 * m20) * det,
						m12: (m02 * m10 - m00 * m12) * det,

						m20: (m10 * m21 - m11 * m20) * det,
						m21: (m01 * m20 - m00 * m21) * det,
						m22: (m00 * m11 - m01 * m10) * det
					);
				}
			}

