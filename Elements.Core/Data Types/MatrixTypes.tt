				);
			}*/

			<#} // end of "if 3x3" #>

			<# // Following is common for both 4x4 and 3x3 #>


			[MethodImpl(MethodImplOptions.AggressiveInlining)]
			public static <#=matrixtype#> Scale(in <#=basetype#>3 v)
			{
				return new <#=matrixtype#>(
					m00: v.x,
					m11: v.y,
					m22: v.z
					<#if(c>=4) { #> , m33: 1 <# } #>
					);
			}

			[MethodImpl(MethodImplOptions.AggressiveInlining)]
			public static <#=matrixtype#> Rotation(in <#=basetype#>Q q)
			{
				var x = q.x;
				var y = q.y;
				var z = q.z;
				var w = q.w;

				var xx = 2*x*x;
				var yy = 2*y*y;
				var zz = 2*z*z;

				var xy = 2*x*y;
				var wz = 2*w*z;
				var xz = 2*x*z;
				var wy = 2*w*y;
				var yz = 2*y*z;
				var wx = 2*w*x;

				return new <#=matrixtype#>(
					m00: (1-yy-zz),	m01: (xy-wz),	m02: (xz+wy),
					m10: (xy+wz),	m11: (1-xx-zz),	m12: (yz-wx),
					m20: (xz-wy),	m21: (yz+wx),	m22: (1-xx-yy)
					<#if(c>=4) { #> , m33: 1 <# } #>);
			}
			
			public static <#=matrixtype#> ScaleRotation(in <#=basetype#>3 scale, in <#=basetype#>Q rotation)
			{
				var x = rotation.x;
				var y = rotation.y;
				var z = rotation.z;
				var w = rotation.w;

				var xx = 2*x*x;
				var yy = 2*y*y;
				var zz = 2*z*z;

				var xy = 2*x*y;
				var wz = 2*w*z;
				var xz = 2*x*z;
				var wy = 2*w*y;
				var yz = 2*y*z;
				var wx = 2*w*x;

				var sx = scale.x;
				var sy = scale.y;
				var sz = scale.z;

				return new <#=matrixtype#>(
					m00: sx*(1-yy-zz),	m01: sy*(xy-wz),	m02: sz*(xz+wy),
					m10: sx*(xy+wz),	m11: sy*(1-xx-zz),	m12: sz*(yz-wx),
					m20: sx*(xz-wy),	m21: sy*(yz+wx),	m22: sz*(1-xx-yy)
					<#if(c>=4) { #> , m33: 1 <# } #>);
			} 

			public readonly <#=basetype#>3 DecomposedScale
			{
				get
				{
					return new <#=basetype#>3(
						MathX.Sqrt(m00*m00 + m10*m10 + m20*m20) /** MathX.Sign(<#if(c==4){#>Determinant3x3<#}else{#>Determinant<#}#>)*/,
						MathX.Sqrt(m01*m01 + m11*m11 + m21*m21),
						MathX.Sqrt(m02*m02 + m12*m12 + m22*m22)
						);
				}
			}

			public readonly <#=basetype#>Q DecomposedRotation
			{
				get
				{
					var m1 = (new <#=basetype#>3(m01, m11, m21)).Normalized;
					var m2 = (new <#=basetype#>3(m02, m12, m22)).Normalized;
					var m0 = MathX.Cross(m1, m2);

					var r0 = m0.x + m1.y + m2.z;

					<#=basetype#> x, y, z, w;

					if (r0 > 0)
					{
						var r1 = MathX.Sqrt(r0 + 1f);
						w = r1 * 0.5f;
						r1 = 0.5f / r1;
						x = (m1.z - m2.y) * r1;
						y = (m2.x - m0.z) * r1;
						z = (m0.y - m1.x) * r1;
					}
					else if((m0.x >= m1.y) && (m0.x >= m2.z))
					{
						var r1 = MathX.Sqrt(((1f + m0.x) - m1.y) - m2.z);
						var r2 = 0.5f / r1;
						x = 0.5f * r1;
						y = (m0.y + m1.x) * r2;
						z = (m0.z + m2.x) * r2;
						w = (m1.z - m2.y) * r2;
					}
					else if (m1.y > m2.z)
					{
						var r1 = MathX.Sqrt(((1f + m1.y) - m0.x) - m2.z);
						var r2 = 0.5f / r1;
						x = (m1.x + m0.y) * r2;
						y = 0.5f * r1;
						z = (m2.y + m1.z) * r2;
						w = (m2.x - m0.z) * r2;
					}
					else
					{
						var r1 = MathX.Sqrt(((1f + m2.z) - m0.x) - m1.y);
						var r2 = 0.5f / r1;
						x = (m2.x + m0.z) * r2;
						y = (m2.y + m1.z) * r2;
						z = 0.5f * r1;
						w = (m0.y - m1.x) * r2;
					}

					return new <#=basetype#>Q(x,y,z,w);
				}
			}

			<#
		}
		#>

		#endregion


		#region ACCESSORS

		public readonly bool IsSquare { get { return <#=(r==c)?"true":"false"#>; } }

		public readonly <#=basetype#> this[int r, int c]	{ get {	return this[c + r * <#=c#>]; }	}

		public readonly <#=basetype#> this[int index]
		{
			get
			{
				switch(index)
				{
					<#
					for(int i = 0; i < elements.Count; i++)
						{
							#>
							case <#=i#>: return <#=elements[i]#>;
							<#
						}
					#>

					default:
						throw new Exception("Invalid matrix element coordinates");
				}
			}
		}

        public readonly <#=basetype#> GetElement(int index) => this[index];

		public readonly <#=basetype#>[] ToArray()
		{
			var array = new <#=basetype#>[<#=r*c#>];
			FillArray(array);
			return array;
		}

		public readonly void FillArray(<#=basetype#>[] array, int offset = 0)
		{
			if(array.Length - offset < <#=r*c#>)
				throw new Exception("Array doesn't have sufficient capacity for the whole matrix");

			<#=H.FormatList((e,i)=>"array[offset+" + i + "] = " + e + ";", "\n\t\t\t", elements.ToArray())#>
		}

		public readonly <#=basetype#>[,] To2DArray()
		{
			var array = new <#=basetype#>[<#=r#>,<#=c#>];
			Fill2DArray(array);
			return array;
		}

		public readonly void Fill2DArray(<#=basetype#>[,] array, int offset0 = 0, int offset1 = 0)
		{
			if(array.GetLength(0) - offset0 < <#=r#> || array.GetLength(1) - offset1 < <#=c#>)
				throw new Exception("Array doesn't have sufficient capacity for the whole matrix");

			for(int r = 0; r < <#=r#>; r++)
				for(int c = 0; c < <#=c#>; c++)
					array[offset0+r, offset1+c] = this[r,c];
		}

		<#for(int _r = 0; _r < r; _r++)
		{
			#>
			public readonly <#=basetype+c#> Row<#=_r#> { get { return new <#=basetype+c#>(<#=H.FormatList(
				c, "m"+_r+"{0}", ",")#>); } }
			<#
		}
		#>

		<#for(int _c = 0; _c < c; _c++)
		{
			#>
			public readonly <#=basetype+r#> Column<#=_c#> { get { return new <#=basetype+r#>(<#=H.FormatList(
				r, "m{0}" + _c, ",")#>); } }
			<#
		}
		#>

