<#    return null; #>

// Autogenerated!!! DO NOT MODIFY!
// Generated on: <#= DateTime.Now #>

using System;
using System.Globalization;
using Elements.Core; using Elements.Data;
using System.IO;

// Wrappers for supported built-in primitives, ensuring they can be used as generics parameters

namespace Elements.Core
{

public interface IDataPrimitive
{
	DataPrimitiveType DataPrimitiveType { get; } 
	void Write(BinaryWriter writer);
	void Read(BinaryReader reader);
	
	string ToStringKey();
	void FromStringKey(string key);
}

public enum DataPrimitiveType
{
	<#= H.FormatList(e=>e.TypeName, ",\n\t", Config.AllSupportedTypes.ToArray()) #>
}

<#

foreach(var info in Config.AllSupportedTypes)
{
	string wrappername = info.TypeName + "X";

	#>

	public struct <#=wrappername#> : IDataPrimitive
	{
		private <#=info.TypeDeclaration#> val;

		public DataPrimitiveType DataPrimitiveType { get { return DataPrimitiveType.<#=info.TypeName#>; } } 

		// constructors
		<#=wrappername#>(<#=info.TypeDeclaration#> val)
		{
			this.val = val;
		}

		// Implicit conversions, so it behaves just like the wrapped type

		public static implicit operator <#=wrappername#>(<#=info.TypeDeclaration#> val)
		{
			return new <#=wrappername#>(val);
		} 

		public static implicit operator <#=info.TypeDeclaration#>(<#=wrappername#> val)
		{
			return val.val;
		}

		// Binary Stream Methods

		public void Write(BinaryWriter writer)
		{
			writer.Write(val);
		}

		public void Read(BinaryReader reader)
		{
			val = reader.Read<#=info.BinaryReaderName#>();
		}
		
		public string ToStringKey()
		{
			<# if(info.TypeName == "String" || info.TypeName == "Bool")
			{#>
				return val.ToString();
			<#}
			else
			{#>
				return val.ToString(CultureInfo.InvariantCulture);
			<#}#>
		}

		public void FromStringKey(string key)
		{
			<# if(info.TypeName == "String")
			{#>
				val = key;
			<#}
			else if(info.TypeName == "Bool")
			{#>
				val = bool.Parse(key);
			<#}
			else
			{#>
				val = <#=info.TypeDeclaration#>.Parse(key, CultureInfo.InvariantCulture);
			<#}#>
		}
	}

	<#
}

#>

}

