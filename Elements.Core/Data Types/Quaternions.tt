		// From: http://gamedev.stackexchange.com/questions/92419/how-to-get-quaternion-from-two-orthogonal-3d-vectors
		public static <#=quattype#> LookRotation(in <#=basetype#>3 forward, in <#=basetype#>3 up)
		{
			if(forward == <#=basetype#>3.Zero)
				return Identity;

			var m2 = forward.Normalized;
            var m0 = MathX.Cross(up, m2);
 
            // check for invalid result
            var m0sqr = m0.SqrMagnitude;
 
            // check for invalid result
            if (MathX.Approximately(m0sqr, 0f))
            {
                var altUp = AxisAngle(<#=basetype#>3.Right, -90) * forward;
                m0 = MathX.Cross(altUp, m2);

                m0sqr = m0.SqrMagnitude;

                if(MathX.Approximately(m0sqr, 0f))
                {
                    altUp = AxisAngle(<#=basetype#>3.Forward, 90) * forward;
                    m0 = MathX.Cross(altUp, m2);

                    m0sqr = m0.SqrMagnitude;
                }
            }

            // Normalize m0. We already computed the square magnitude
            // so we just do part of normalization here manually
            var m0mag = MathX.Sqrt(m0sqr);
            var invMag = 1 / m0mag;
            m0 *= invMag;			

			var m1 = MathX.Cross(m2, m0);			

			var r0 = m0.x + m1.y + m2.z;

			<#=basetype#> x, y, z, w;

			if (r0 > 0)
			{
				var r1 = MathX.Sqrt(r0 + 1f);
				w = r1 * 0.5f;
				r1 = 0.5f / r1;
				x = (m1.z - m2.y) * r1;
				y = (m2.x - m0.z) * r1;
				z = (m0.y - m1.x) * r1;
			}
			else if((m0.x >= m1.y) && (m0.x >= m2.z))
			{
				var r1 = MathX.Sqrt(((1f + m0.x) - m1.y) - m2.z);
				var r2 = 0.5f / r1;
				x = 0.5f * r1;
				y = (m0.y + m1.x) * r2;
				z = (m0.z + m2.x) * r2;
				w = (m1.z - m2.y) * r2;
			}
			else if (m1.y > m2.z)
			{
				var r1 = MathX.Sqrt(((1f + m1.y) - m0.x) - m2.z);
				var r2 = 0.5f / r1;
				x = (m1.x + m0.y) * r2;
				y = 0.5f * r1;
				z = (m2.y + m1.z) * r2;
				w = (m2.x - m0.z) * r2;
			}
			else
			{
				var r1 = MathX.Sqrt(((1f + m2.z) - m0.x) - m1.y);
				var r2 = 0.5f / r1;
				x = (m2.x + m0.z) * r2;
				y = (m2.y + m1.z) * r2;
				z = 0.5f * r1;
				w = (m0.y - m1.x) * r2;
			}

			return new <#=quattype#>(x,y,z,w);
		}

		public static <#=quattype#> Euler(<#=basetype#> x, <#=basetype#> y, <#=basetype#> z)
