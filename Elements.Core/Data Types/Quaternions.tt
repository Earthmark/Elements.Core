		public static <#=quattype#> Parse(string s, IFormatProvider provider)
		{
			return (<#=quattype#>)<#=basetype#>4.Parse(s, provider);
		}

		public static <#=quattype#> Parse(string s, NumberStyles style)
		{
			return (<#=quattype#>)<#=basetype#>4.Parse(s, style);
		}

		public static <#=quattype#> Parse(string s, NumberStyles style, IFormatProvider provider)
		{
			return (<#=quattype#>)<#=basetype#>4.Parse(s, style, provider);
		}

		public static bool TryParse(string s, out <#=quattype#> val)
		{
			<#=basetype#>4 val4;
			bool parsed = <#=basetype#>4.TryParse(s, out val4);
			val = (<#=quattype#>)val4;
			return parsed;
		}

        public static bool TryParse(string s, NumberStyles style, IFormatProvider provider, out <#=quattype#> val)
		{
			<#=basetype#>4 val4;
			bool parsed = <#=basetype#>4.TryParse(s, style, provider, out val4);
			val = (<#=quattype#>)val4;
			return parsed;
		}

		#endregion

		
		#region SWIZZLES

		<#=H.GenerateSwizzles("xyzw", 4, 2, 4,
			(size,swizzle,expression)=>
				"[DebuggerBrowsable(DebuggerBrowsableState.Never)]\n" +
				"public readonly " + basetype + size + " " + swizzle + " { get { return new " + basetype + size + "(" + expression + "); } }")#>

		#endregion

		#region OPERATIONS

		[MethodImpl(MethodImplOptions.AggressiveInlining)]
		public static <#=quattype#> InvertedMultiply(in <#=quattype#> a, in <#=quattype#> b)
		{
            return new <#=quattype#>(
				(-a.x * b.w + b.x * a.w - a.y * b.z) + (a.z * b.y),
				(-a.y * b.w + b.y * a.w - a.z * b.x) + (a.x * b.z),
				(-a.z * b.w + b.z * a.w - a.x * b.y) + (a.y * b.x),
				(a.w * b.w) - (-a.x * b.x - a.y * b.y - a.z * b.z));
		}

		[MethodImpl(MethodImplOptions.AggressiveInlining)]
		public static <#=basetype#>3 InvertedMultiply(in <#=quattype#> q, in <#=basetype#>3 v)
		{
			var x = q.x + q.x;
			var y = q.y + q.y;
			var z = q.z + q.z;
			var wx = -q.w * x;
			var wy = -q.w * y;
			var wz = -q.w * z;
			var xx = q.x * x;
			var xy = q.x * y;
			var xz = q.x * z;
			var yy = q.y * y;
			var yz = q.y * z;
			var zz = q.z * z;

			var num1 = ((1 - yy) - zz);
			var num2 = (xy - wz);
			var num3 = (xz + wy);
			var num4 = (xy + wz);
			var num5 = ((1 - xx) - zz);
			var num6 = (yz - wx);
			var num7 = (xz - wy);
			var num8 = (yz + wx);
			var num9 = ((1 - xx) - yy);

			return new <#=basetype#>3(
				((v.x * num1) + (v.y * num2)) + (v.z * num3),
				((v.x * num4) + (v.y * num5)) + (v.z * num6),
				((v.x * num7) + (v.y * num8)) + (v.z * num9));
		}

		#endregion
	}

	// Extensions

	public static partial class MathX
	{
		<#if(basetype == "double")
		{
			#>

			public static doubleQ Slerp(in doubleQ a, in doubleQ b, float lerp)
			{
				return Slerp(a, b, (double)lerp);
			}

			public static doubleQ Lerp(in doubleQ a, in doubleQ b, float lerp)
			{
				return Lerp(a, b, (double)lerp).FastNormalized;
			}

			<#
		}
		#>

		public static <#=quattype#> ReflectRotation(in <#=quattype#> rotation, in <#=basetype#>3 planeNormal)
		{
			// TODO!!! An optimized version, using Reflection Matrix?
			var forward = rotation * <#=basetype#>3.Forward;
			var up = rotation * <#=basetype#>3.Up;

			forward = MathX.ReflectVector(forward, planeNormal);
			up = MathX.ReflectVector(up, planeNormal);

			return <#=quattype#>.LookRotation(forward, up);
		}

		public static <#=basetype#> AngleAroundAxis(<#=quattype#> rotation, <#=basetype#>3 axis, <#=basetype#>3? comparisonAxis = null)
		{
			<#=basetype#>3 comparison;
			if(comparisonAxis != null)
				comparison = comparisonAxis.Value;
			else
				MathX.Orthonormals(axis, out comparison, out _);

			var rotated = rotation * comparison;

			// project both rotated and comparsion on the plane given by the axis and compute the angles they represent
			var toUp = <#=quattype#>.FromToRotation(axis, float3.Up);

			rotated = toUp * rotated;
			comparison = toUp * comparison;

			var rotatedAngle = MathX.Atan2(rotated.xz) * MathX.Rad2Deg;
			var comparisonAngle = MathX.Atan2(comparison.xz) * MathX.Rad2Deg;

			return MathX.DeltaAngle(comparisonAngle, rotatedAngle);
		}

		// Adapted from BEPUPhysics
		public static <#=quattype#> Slerp(in <#=quattype#> a, <#=quattype#> b, <#=basetype#> lerp)
		{
			if(lerp <= 0)
				return a;
			if(lerp >= 1)
				return b;

			return SlerpUnclamped(a, b, lerp);
		}

        public static <#=quattype#> SlerpUnclamped(in <#=quattype#> a, <#=quattype#> b, <#=basetype#> lerp)
		{
			<#=basetype#> cosHalfTheta = a.w * b.w + a.x * b.x + a.y * b.y + a.z * b.z;

            if (cosHalfTheta < 0)
            {
                b = b.Negated;
                cosHalfTheta = -cosHalfTheta;
            }

            if (cosHalfTheta >= 1)
				return b;

            var halfTheta = MathX.Acos(cosHalfTheta);
            var sinHalfTheta = MathX.Sqrt(1 - cosHalfTheta * cosHalfTheta);

            var aFraction = MathX.Sin((1 - lerp) * halfTheta) / sinHalfTheta;
            var bFraction = MathX.Sin(lerp * halfTheta) / sinHalfTheta;

			return new <#=quattype#>(
				a.x * aFraction + b.x * bFraction,
				a.y * aFraction + b.y * bFraction,
				a.z * aFraction + b.z * bFraction,
				a.w * aFraction + b.w * bFraction
			);
		}

        public static <#=quattype#> BezierCurve(<#=quattype#> from, <#=quattype#> to, <#=quattype#> fromTangent, <#=quattype#> toTangent, float t)
        {
            var u = 1f - t;
            var tt = t * t;
            var uu = u * u;
            var ttt = tt * t;
            var uuu = uu * u;

            return (uuu * from +
                (3 * uu * t * fromTangent) +
                (3 * u * tt * toTangent) +
                ttt * to).Normalized;
        }

        public static <#=quattype#> BezierTangent(<#=quattype#> from, <#=quattype#> to, <#=quattype#> fromTangent, <#=quattype#> toTangent, float t)
        {
            return (-3f * MathX.Pow(1f - t, 2f) * from +
                3f * MathX.Pow(1f - t, 2f) * fromTangent -
                6f * t * (1f - t) * fromTangent -
                3f * MathX.Pow(t, 2f) * toTangent +
                6f * t * (1f - t) * toTangent +
                3f * MathX.Pow(t, 2f) * to).Normalized;
        }

		[MethodImpl(MethodImplOptions.AggressiveInlining)]
		public static <#=quattype#> Lerp(in <#=quattype#> a, in <#=quattype#> b, <#=basetype#> lerp)
		{
			if(lerp <= 0)
				return a;
			if(lerp >= 1)
				return b;

			return new <#=quattype#>(a.x + (b.x - a.x) * lerp, a.y + (b.y - a.y) * lerp, a.z + (b.z - a.z) * lerp, a.w + (b.w - a.w) * lerp).FastNormalized;;
		}

		[MethodImpl(MethodImplOptions.AggressiveInlining)]
		public static <#=quattype#> LerpUnclamped(in <#=quattype#> a, in <#=quattype#> b, <#=basetype#> lerp)
		{
			return new <#=quattype#>(a.x + (b.x - a.x) * lerp, a.y + (b.y - a.y) * lerp, a.z + (b.z - a.z) * lerp, a.w + (b.w - a.w) * lerp).FastNormalized;
		}

		[MethodImpl(MethodImplOptions.AggressiveInlining)]
		public static <#=basetype#> Dot(in <#=quattype#> a, in <#=quattype#> b)
		{
			return a.x*b.x + a.y*b.y + a.z*b.z + a.w*b.w;
		}

		[MethodImpl(MethodImplOptions.AggressiveInlining)]
		public static <#=basetype#> AngleRad(in <#=quattype#> a, in <#=quattype#> b)
		{
			return MathX.Acos(MathX.Min(MathX.Abs(Dot(a,b)), 1)) * 2;
		}

		[MethodImpl(MethodImplOptions.AggressiveInlining)]
		public static <#=basetype#> Angle(in <#=quattype#> a, in <#=quattype#> b)
		{
			return MathX.Acos(MathX.Min(MathX.Abs(Dot(a,b)), 1)) * 2 * MathX.Rad2Deg;
		}

		public static <#=quattype#> RotateTowards(in <#=quattype#> from, in <#=quattype#> to, <#=basetype#> maxAngle)
		{
			var angle = MathX.Angle(from, to);

			if(angle == 0)
				return from;

			var ratio = MathX.Min(1, maxAngle / angle);
			return MathX.Slerp(from, to, ratio);
		}

        public static <#=quattype#> RotateByAngle(in <#=quattype#> from, in <#=quattype#> to, <#=basetype#> rotationAngle)
		{
			var angle = MathX.Angle(from, to);

			if(angle == 0)
				return from;

			var ratio = rotationAngle / angle;
			return MathX.Slerp(from, to, ratio);
		}

		public static <#=quattype#> LimitSwing(in <#=quattype#> rotation, in <#=basetype#>3 axis, <#=basetype#> maxAngle)
		{
			if(axis == <#=basetype#>3.Zero)
				return rotation;

			var targetAxis = rotation * axis;
			var targetRotation = <#=quattype#>.FromToRotation(axis, targetAxis);
			var limitedRotation = RotateTowards(<#=quattype#>.Identity, targetRotation, maxAngle);
			var limitedAxis = limitedRotation * axis;

			var fix = <#=quattype#>.FromToRotation(targetAxis, limitedAxis);

			return fix * rotation;
		}

        public static <#=quattype#> SetSwing(in <#=quattype#> rotation, in <#=basetype#>3 axis, <#=basetype#> swingAngle)
		{
			if(axis == <#=basetype#>3.Zero)
				return rotation;

			var targetAxis = rotation * axis;
			var targetRotation = <#=quattype#>.FromToRotation(axis, targetAxis);
			var limitedRotation = RotateByAngle(<#=quattype#>.Identity, targetRotation, swingAngle);
			var limitedAxis = limitedRotation * axis;

			var fix = <#=quattype#>.FromToRotation(targetAxis, limitedAxis);

			return fix * rotation;
		}

		public static <#=quattype#> LimitTwist(in <#=quattype#> rotation, in <#=basetype#>3 axis, 
			in <#=basetype#>3 orthoAxis, <#=basetype#> maxAngle)
		{
			if(maxAngle >= 180)
				return rotation;

			maxAngle = MathX.Clamp(maxAngle, 0, 180);

			var normal = rotation * axis;
			var orthoTangent = orthoAxis;
			MathX.Orthonormalize(ref normal, ref orthoTangent);

			var rotatedOrthoTangent = rotation * orthoAxis;
			MathX.Orthonormalize(ref normal, ref rotatedOrthoTangent);

			var fixedRotation = <#=quattype#>.FromToRotation(rotatedOrthoTangent, orthoTangent) * rotation;

			if(maxAngle == 0)
				return fixedRotation;

			return MathX.RotateTowards(fixedRotation, rotation, maxAngle);
		}

        // Based on: https://stackoverflow.com/questions/3684269/component-of-a-quaternion-rotation-around-an-axis
        public static void DecomposeSwingTwist(in <#=quattype#> rotation, in <#=basetype#>3 axis,
            out <#=quattype#> swing, out <#=quattype#> twist)
        {
            var ra = rotation.xyz;
            var p = MathX.Project(ra, axis);
            
            twist = new <#=quattype#>(p.x, p.y, p.z, rotation.w);
            twist = twist.Normalized;

            swing = rotation * twist.Conjugated;
        }

        public static <#=basetype#> AxisAngle(in <#=quattype#> rotation)
        {
            return 2 * MathX.Acos(rotation.w) * MathX.Rad2Deg;
        }

        public static void DecomposeAxisAngle(in <#=quattype#> rotation, out <#=basetype#>3 axis, out <#=basetype#> angle)
        {
            angle = 2 * MathX.Acos(rotation.w);
            var s = MathX.Sqrt(1-rotation.w*rotation.w);
            if(s == 0)
                axis = <#=basetype#>3.Forward;
            else
                axis = rotation.xyz / s;

            angle *= MathX.Rad2Deg;
        }

		[MethodImpl(MethodImplOptions.AggressiveInlining)]
		public static <#=quattype#> Abs(in <#=quattype#> q)
		{
			return new <#=quattype#>(<#=H.FormatElements("xyzw", "MathX.Abs(q.{0})", ", ")#>);
		}

        [MethodImpl(MethodImplOptions.AggressiveInlining)]
        public static <#=quattype#> Pow(in <#=quattype#> q, <#=basetype#> pow)
        {
            var angle = MathX.Acos(MathX.Clamp(q.w, -1, 1));
            var sinAngle = MathX.Sin(angle);

            if(MathX.Approximately(sinAngle, 0))
                return q;

            var unitVector = q.xyz / sinAngle;

            var newAngle = angle * pow;

            var newW = MathX.Cos(newAngle);
            var newV = unitVector * MathX.Sin(newAngle);

            return new <#=quattype#>(newV.x, newV.y, newV.z, newW);
        }

