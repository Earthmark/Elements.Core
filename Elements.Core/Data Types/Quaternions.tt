		public static <#=quattype#> AxisAngleRad(<#=basetype#>3 axis, <#=basetype#> radians)
		{
			radians *= 0.5f;
			axis = axis.Normalized * MathX.Sin(radians);

			return new <#=quattype#>(axis.x, axis.y, axis.z, MathX.Cos(radians));
		}

