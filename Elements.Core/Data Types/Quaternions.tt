            rotation = modRot * rotation;

            var refVec = rotation * <#=basetype#>3.Right;
            
            return MathX.Atan2(refVec.xy) * MathX.Rad2Deg;                                        
        }*/
	}

	public static class <#=H.Capitalize(quattype)#>Extensions
	{
		public static void Write(this BinaryWriter wr, in <#=quattype#> q)
		{
			wr.Write(q.x);
			wr.Write(q.y);
			wr.Write(q.z);
			wr.Write(q.w);
		}

		public static <#=quattype#> Read<#=type.BinaryReaderName#>(this BinaryReader rd)
		{
			return new <#=quattype#>(
				rd.Read<#=type.BaseType.BinaryReaderName#>(),
				rd.Read<#=type.BaseType.BinaryReaderName#>(),
				rd.Read<#=type.BaseType.BinaryReaderName#>(),
				rd.Read<#=type.BaseType.BinaryReaderName#>()
			);
		}
	}

