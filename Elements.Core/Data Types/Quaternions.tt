		// Quaternion multiplication
		[MethodImpl(MethodImplOptions.AggressiveInlining)]
		public static <#=quattype#> operator*(in <#=quattype#> a, in <#=quattype#> b)
		{
            return new <#=quattype#>(
				(a.x * b.w + b.x * a.w + a.y * b.z) - (a.z * b.y),
				(a.y * b.w + b.y * a.w + a.z * b.x) - (a.x * b.z),
				(a.z * b.w + b.z * a.w + a.x * b.y) - (a.y * b.x),
				(a.w * b.w) - (a.x * b.x + a.y * b.y + a.z * b.z));
		}

		// Rotating vector
		[MethodImpl(MethodImplOptions.AggressiveInlining)]
		public static <#=basetype#>3 operator*(in <#=quattype#> q, in <#=basetype#>3 v)
		{
			var x = q.x + q.x;
			var y = q.y + q.y;
			var z = q.z + q.z;
			var wx = q.w * x;
			var wy = q.w * y;
			var wz = q.w * z;
			var xx = q.x * x;
			var xy = q.x * y;
			var xz = q.x * z;
			var yy = q.y * y;
			var yz = q.y * z;
			var zz = q.z * z;

			var num1 = ((1 - yy) - zz);
			var num2 = (xy - wz);
			var num3 = (xz + wy);
			var num4 = (xy + wz);
			var num5 = ((1 - xx) - zz);
			var num6 = (yz - wx);
			var num7 = (xz - wy);
			var num8 = (yz + wx);
			var num9 = ((1 - xx) - yy);

			return new <#=basetype#>3(
				((v.x * num1) + (v.y * num2)) + (v.z * num3),
				((v.x * num4) + (v.y * num5)) + (v.z * num6),
				((v.x * num7) + (v.y * num8)) + (v.z * num9));
		}

