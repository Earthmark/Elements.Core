		}

        public static <#=quattype#> EulerRad(in <#=basetype#>3 rotation)
        {
            var r = rotation * 0.5f;

            var sinx = MathX.Sin(r.x);
			var siny = MathX.Sin(r.y);
			var sinz = MathX.Sin(r.z);

			var cosx = MathX.Cos(r.x);
			var cosy = MathX.Cos(r.y);
			var cosz = MathX.Cos(r.z);

			return new <#=quattype#>(
				cosy * sinx * cosz + siny * cosx * sinz,
				siny * cosx * cosz - cosy * sinx * sinz,
				cosy * cosx * sinz - siny * sinx * cosz,
				cosy * cosx * cosz + siny * sinx * sinz
			);
        }

		public static <#=quattype#> Euler(in <#=basetype#>3 rotation) => EulerRad(rotation * MathX.Deg2Rad);

        public static <#=quattype#> DeltaRotation(in <#=basetype#>3 angularVelocity, <#=basetype#> deltaTime)
        {
            return DeltaRotationRad(angularVelocity * MathX.Deg2Rad, deltaTime);
        }

        public static <#=quattype#> DeltaRotationRad(in <#=basetype#>3 angularVelocity, <#=basetype#> deltaTime)
        {
            var halfAngle = angularVelocity * (deltaTime * 0.5f);
            var mag = halfAngle.Magnitude;

            if(!MathX.Approximately(mag, 0))
                halfAngle *= MathX.Sin(mag) / mag;

            return new <#=quattype#>(halfAngle.x, halfAngle.y, halfAngle.z, MathX.Cos(mag));
        }

		public static <#=quattype#> FromToRotation(<#=quattype#> from, <#=quattype#> to)
		{
			return to * from.Inverted;
		}

		public static <#=quattype#> FromToRotation(in <#=basetype#>3 from, in <#=basetype#>3 to)
		{
			var dot = MathX.Dot(from, to);

			if(from == to || from == <#=basetype#>3.Zero || to == <#=basetype#>3.Zero)
				return <#=quattype#>.Identity;

			var cross = MathX.Cross(from, to);

			if(cross.SqrMagnitude <= 1e-8f && dot < 0f)
			{
				var temp = MathX.Cross(new <#=basetype#>3(1,0,0), from);

				if(temp.SqrMagnitude <= 1e-8f)
					temp = MathX.Cross(new <#=basetype#>3(0,1,0), from);
				
				return <#=quattype#>.AxisAngleRad(temp.Normalized, MathX.PI);
			}

			return (new <#=quattype#>(cross.x, cross.y, cross.z,
				MathX.Sqrt( from.SqrMagnitude * to.SqrMagnitude ) + dot )).Normalized;
		}
		
