    [MethodImpl(MethodImplOptions.AggressiveInlining)]
	public static <#=vectortype#> Min(params <#=vectortype#>[] vals)
    {
		if(vals.Length <= 1)
			throw new ArgumentException("Invalid number of values: " + vals.Length);

        var min = vals[0];

        for(int i = 1; i < vals.Length; i++)
            min = Min(min, vals[i]);

        return min;
    }

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
	public static <#=vectortype#> Max(params <#=vectortype#>[] vals)
    {
		if(vals.Length <= 1)
			throw new ArgumentException("Invalid number of values: " + vals.Length);

        var max = vals[0];

        for(int i = 1; i < vals.Length; i++)
            max = Max(max, vals[i]);

        return max;
    }

	[MethodImpl(MethodImplOptions.AggressiveInlining)]
	public static bool Approximately(in <#=vectortype#> a, in <#=vectortype#> b)
