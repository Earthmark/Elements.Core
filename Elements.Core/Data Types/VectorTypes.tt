} // namespace Elements.Core;


<#+

public static class T
{
	public static List<string> floatTypes = new List<string>() { "float", "double", "decimal" };
	public static List<string> signedTypes = new List<string>() { "sbyte", "short", "int", "long" };
	public static List<string> unsignedTypes = new List<string>() { "byte", "ushort", "uint", "ulong" };
	public static List<string> typePriorityList;

	// Syntax:
	// <return basetype>Name|arg0|arg1...

	public static List<string> floatMathFunctions = new List<string>() {
		"Sin", "Cos", "Tan", "Asin", "Acos", "Atan", "Atan2|y|x", "Sqrt", "Pow|v|p", "Exp", "Log", "Log|v|newBase", "Log10",
		"Abs", "Min|a|b", "Max|a|b", "Clamp01", "Clamp|vector|min|max", "Round", "<int>RoundToInt", "Ceil", "<int>CeilToInt",
		"Lerp|from|to|lerp", "LerpUnclamped|from|to|lerp", "InverseLerp|from|to|value", "Sign", "Repeat|v|length", "Repeat01", "PingPong|v|length", "PingPongSafe|v|length", "Snap|v|increment",
		"Floor", "<int>FloorToInt", "CubicLerp|from|fromTangent|to|toTangent|lerp",
        "<int>LegacyCeilToInt",  "<int>LegacyRoundToInt", "<int>LegacyFloorToInt", "<int>LegacyCastToInt"
        };

	public static List<string> intMathFunctions = new List<string>() {
		"Abs|n", "Clamp|vector|min|max", "Min|a|b", "Max|a|b", "Sign|n", "Repeat|v|length", "PingPong|v|length", "PingPongSafe|v|length"
	};

	public static List<List<string>> dataTypeGroups;
	public static List<List<string>> dataTypeGroupsAndVectors;	// includes unity vectors 

	public static Dictionary<string, string> binaryReaderTypes = new Dictionary<string, string>()
	{
		{ "float",		"Single" },
		{ "double",		"Double" },
		{ "decimal",	"Decimal" },

		{ "sbyte",		"SByte" },
		{ "short",		"Int16" },
		{ "int",		"Int32" },
		{ "long",		"Int64" },

		{ "byte",		"Byte" },
		{ "ushort",		"UInt16" },
		{ "uint",		"UInt32" },
		{ "ulong",		"UInt64" },
	};

	static T()
	{
		 dataTypeGroups = new List<List<string>>() { floatTypes, signedTypes, unsignedTypes };
		 dataTypeGroupsAndVectors = new List<List<string>>(dataTypeGroups);

		 typePriorityList = new List<string>();

		 typePriorityList.AddRange(unsignedTypes);
		 typePriorityList.AddRange(signedTypes);
		 typePriorityList.AddRange(floatTypes);		 
		 
		 var vectorgroup = new List<string>() { "Vector" };
		 dataTypeGroupsAndVectors.Add(vectorgroup);
	}
}

bool CanHold(string basetype, string target)
{
	if(IsFloatingPoint(basetype))
		return FloatIndex(basetype) >= FloatIndex(target);
	else if(IsSignedInt(basetype))
	{
		if(IsSignedInt(target))
			return SignedIndex(basetype) >= SignedIndex(target);
		if(IsUnsignedInt(target))
			return SignedIndex(basetype) > UnsignedIndex(target);
	}
	else if(IsUnsignedInt(target))
		return UnsignedIndex(basetype) >= UnsignedIndex(target);		

	return false;
}

string PromoteType(string a, string b)
{
    if(a == "bool" && b == "bool")
            return "bool";

	if(IsFloatingPoint(a) || IsFloatingPoint(b))
	{
		int aindex = FloatIndex(a);
		int bindex = FloatIndex(b);
		return T.floatTypes[Math.Max(aindex, bindex)];
	}
	else if(IsSignedInt(a) || IsSignedInt(b))
	{
		int unsigned_index = Math.Max( UnsignedIndex(a), UnsignedIndex(b) );

		if(unsigned_index >= 0)
			unsigned_index = Math.Max(UnsignedIndex("uint"), unsigned_index);

		int signed_index = Math.Max( SignedIndex(a), Math.Max(SignedIndex(b), SignedIndex("int")) );
		signed_index = Math.Max(signed_index, unsigned_index);


		if(unsigned_index == signed_index && signed_index < T.signedTypes.Count-1)
			signed_index++;

		return T.signedTypes[signed_index];
	}
	else
		return T.unsignedTypes[Math.Max(UnsignedIndex(a), Math.Max(UnsignedIndex(b), UnsignedIndex("uint")) )];
}

bool IsFloatingPoint(string basetype)
{
	return T.floatTypes.Contains(basetype);
}

bool IsInt(string baseType)
{
	return IsSignedInt(baseType) || IsUnsignedInt(baseType);
}

bool IsSignedInt(string basetype)
{
	return T.signedTypes.Contains(basetype);
}

bool IsUnsignedInt(string basetype)
{
	return T.unsignedTypes.Contains(basetype);
}

int FloatIndex(string basetype)
{
	return T.floatTypes.IndexOf(basetype);
}

int SignedIndex(string basetype)
{
	return T.signedTypes.IndexOf(basetype);
}

int UnsignedIndex(string basetype)
{
	return T.unsignedTypes.IndexOf(basetype);
}

string Separator(int el, int dim, char separator)
{
	if(el < dim-1)
		return separator.ToString();
	else
		return "";
}
#>
