#region OPERATORS

	<#

	bool generateOperators = true;

	if(IsSignedInt(basetype) && SignedIndex(basetype) < SignedIndex("int"))
		generateOperators = false;
	if(IsUnsignedInt(basetype) && UnsignedIndex(basetype) < UnsignedIndex("uint"))
		generateOperators = false;

	if(generateOperators)
	{
        if(basetype == "bool")
        {
            #>
			[MethodImpl(MethodImplOptions.AggressiveInlining)]
            public static <#=vectortype#> operator !(<#=vectortype#> v)
			{
				return new <#=vectortype#>(<#=H.FormatElements(elements, "!v.{0}", ",")#>);
			}
