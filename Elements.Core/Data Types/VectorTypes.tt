	}

	public static <#= vectortype #> Read<#= typeinfo.BinaryReaderName #>(this BinaryReader br)
	{
        <#if(basetype == "bool") { #>return new <#=vectortype#>(br.ReadByte());<# } else { #>
		return new <#= vectortype #>(<# for(int i = 0; i < n; i++)
		{ #> br.Read<#= baseinfo.BinaryReaderName #>()<#= (i<n-1)?",":"" #> <# } #>); <#}#>
	}
}


public static partial class MathX
{
