		}
		
		#>

		<#
		List<string> operators = new List<string>() { "+", "-", "*", "/", "%" } ; 
		var opNames = new List<string> { "Add", "Subtract", "Multiply", "Divide", "Modulo" };
		var selfOnly = new HashSet<string>();

        if(basetype == "bool")
		{
            operators = new List<string>() { "&", "|", "^" };
			opNames = new List<string> { "And", "Or", "Xor" };
		}

		if(IsInt(basetype))
		{
            operators.Add("&");
            operators.Add("|");
            operators.Add("^");

			opNames.Add("And");
			opNames.Add("Or");
			opNames.Add("Xor");

			selfOnly.Add("And");
			selfOnly.Add("Or");
			selfOnly.Add("Xor");
		}

		for(int o = 0; o < operators.Count; o++)
		{
			var op = operators[o];
			var opName = opNames[o];
			#>

			[MethodImpl(MethodImplOptions.AggressiveInlining)]
			public static <#=vectortype#> operator <#= op #>(in <#=vectortype#> a, in <#=vectortype#> b)
			{
				return new <#=vectortype#>(<#=H.FormatElements(elements,
					"(" + basetype + ")a.{0}" + op + "(" + basetype + ")b.{0}", ",") #>);
			}

			[MethodImpl(MethodImplOptions.AggressiveInlining)]
			public static <#=vectortype#> <#=opName#>(ref <#=vectortype#> a, ref <#=vectortype#> b)
			{
				return new <#=vectortype#>(<#=H.FormatElements(elements,
					"(" + basetype + ")a.{0}" + op + "(" + basetype + ")b.{0}", ",") #>);
			}

			<#
			foreach(var basetypeinfo in Config.VectorBaseTypes)
				{
					string _type = basetypeinfo.TypeDeclaration;
					string targetType = PromoteType(_type, basetype);
					string target = targetType + n;

                    if(basetype == "bool" && _type != "bool")
                        continue;

                    if(basetype != "bool" && _type == "bool")
                        continue;

					if(selfOnly.Contains(opName) && basetype != _type)
						continue;

					#>
					[MethodImpl(MethodImplOptions.AggressiveInlining)]
					public static <#=target#> operator <#= op #>(in <#=vectortype#> v, <#=_type#> n)
					{
						return new <#=target#>(<#= H.FormatElements(elements,
							"(" + targetType + ")v.{0}" + op + "(" + targetType + ")n", ",") #>);
