	#region VECTOR OPERATOR FUNCTIONS
		
		<#
		var distanceType = basetype == "double" ? "double" : "float";
		#>

		[MethodImpl(MethodImplOptions.AggressiveInlining)]
		public static <#=basetype#> DistanceSqr(in <#=vectortype#> a, in <#=vectortype#> b)
		{
			return (<#=basetype#>)(<#=H.FormatElements(elements, "((a.{0}-b.{0})*(a.{0}-b.{0}))", "+")#>);
		}

		[MethodImpl(MethodImplOptions.AggressiveInlining)]
		public static <#=distanceType#> Distance(in <#=vectortype#> a, in <#=vectortype#> b)
		{
			return MathX.Sqrt((<#=distanceType#>)DistanceSqr(a, b));
		}

#endregion

    <#}#>

	<#
	if(basetype == "float" || basetype == "double" || basetype == "int" || basetype == "uint"
		|| basetype == "long" || basetype == "ulong")
	{
		List<string> functions = null;

		if(basetype == "float" || basetype == "double")
			functions = T.floatMathFunctions;
		if(basetype == "int" || basetype == "uint" || basetype == "long" || basetype == "ulong")
			functions = T.intMathFunctions;

		foreach(var func in functions)
		{ 
			string fname;
			string[] arguments;
			string rettype = basetype;

			string ftemp = string.Copy(func);

			if(ftemp[0] == '<')
			{
				int endindex = ftemp.IndexOf('>');
				rettype = ftemp.Substring(1, endindex-1);
				ftemp = ftemp.Substring(endindex+1);
			}

			rettype = rettype + n;

			if(!ftemp.Contains("|"))
			{
				fname = ftemp;
				arguments = new string[] { "v" };
			}
			else
			{
				int index = ftemp.IndexOf("|");
				fname = ftemp.Substring(0, index);
				arguments = ftemp.Substring(index+1).Split('|');
			}

			// Abs is not supported for unsigned types
			if((fname == "Abs" || fname == "Sign") && basetype[0] == 'u')
				continue;

			List<string> fparams = new List<string>();
			List<string> fformat = new List<string>();

			int variants = (int)Math.Pow(2, arguments.Length);

			for(int i = 0; i < variants; i++)
			{
				string param = "";
				string format = "";

				bool hasVector = false;
				bool allVector = true;

				for(int p = 0; p < arguments.Length; p++)
				{
					bool isVector = (( (i-1)>>p)&1)==0;
					if(isVector)
					{
						hasVector = true;

						param += "in " + vectortype + " " + arguments[p];
						format += arguments[p] + ".{0}";
					}
					else
					{
						allVector = false;

						param += basetype + " " + arguments[p];
						format += arguments[p];
					}

					if(p < arguments.Length-1)
					{
						param += ", ";
						format += ", ";
					}
				}

				// skip param combinations without any vector
				if(!hasVector)
					continue;

				// Generate Lerp variant only for all-vector version, the others are using optimized variants
				if(!allVector && fname == "Lerp")
					continue;

				fparams.Add(param);
				fformat.Add(format);
			}

			for(int i = 0; i < fparams.Count; i++)
			{
				string param = fparams[i];
				string format = fformat[i];
				
				#>	
				[MethodImpl(MethodImplOptions.AggressiveInlining)]
				public static <#= rettype + " " + fname #>(<#= param #>)
					{
						return new <#= rettype + "(" +
						H.FormatElements(elements, "MathX." + fname + "(" + format + ")", ",") + ");" #>
					}

				<#
			}
		
		} #>

		<# if(basetype == "float" || basetype == "double")
		{#>

			[MethodImpl(MethodImplOptions.AggressiveInlining)]
			public static <#=basetype#> AvgComponent(in <#=vectortype#> v)
			{
				return (<#=H.FormatElements(elements, "v.{0}", " + ")#>) * <#=vectortype#>.COMPONENT_RATIO;
			}

			[MethodImpl(MethodImplOptions.AggressiveInlining)]
			public static <#=basetype#> Dot(in <#=vectortype#> a, in <#=vectortype#> b)
			{
				return <#=H.FormatElements(elements, "a.{0}*b.{0}", " + ")#>;
			}
			 
			[MethodImpl(MethodImplOptions.AggressiveInlining)]
			public static <#=vectortype#> Project(in <#=vectortype#> a, in <#=vectortype#> b)
			{
				var bNorm = b.Normalized;
				return bNorm * Dot(a,bNorm);
			}

			[MethodImpl(MethodImplOptions.AggressiveInlining)]
            public static <#=vectortype#> Reject(in <#=vectortype#> a, in <#=vectortype#> b) => a - Project(a,b);

			[MethodImpl(MethodImplOptions.AggressiveInlining)]
			public static <#=basetype#> AngleRad(in <#=vectortype#> a, in <#=vectortype#> b)
			{
				return MathX.Acos(MathX.Clamp(MathX.Dot(a.Normalized,b.Normalized), -1, 1));
			}

			[MethodImpl(MethodImplOptions.AggressiveInlining)]
			public static <#=basetype#> Angle(in <#=vectortype#> a, in <#=vectortype#> b) => AngleRad(a, b) * MathX.Rad2Deg;


            <#if(n == 2)
            {
                #>

                // Computes the angle between the two vectors, with the sign indicating if it goes clockwise or counter-clockwise.
                // Positive is clockwise and negative counter-clockwise. Positive Y is up.
                [MethodImpl(MethodImplOptions.AggressiveInlining)]
			    public static <#=basetype#> DeltaAngle(in <#=vectortype#> from, in <#=vectortype#> to) => DeltaAngleRad(from, to) * MathX.Rad2Deg;

                public static <#=basetype#> DeltaAngleRad(in <#=vectortype#> from, in <#=vectortype#> to)
                {
                    var dot = from.x * to.x + from.y * to.y;
                    var det = from.x * to.y - from.y * to.x;

                    return -Atan2(det, dot);
                }

                <#
            }
            #>

			public static <#=vectortype#> AxisAligned(in <#=vectortype#> v)
			{
				var abs = MathX.Abs(v);

				<#
				switch(n)
				{
					case 2:
					#>
					if(abs.x > abs.y)
						return new <#=vectortype#>(MathX.Sign(v.x), 0);
					else
						return new <#=vectortype#>(0, MathX.Sign(v.y));
					<#
						break;

					case 3:
					#>
						if(abs.x > abs.y && abs.x > abs.z)
							return new <#=vectortype#>(MathX.Sign(v.x), 0, 0);

						if(abs.y > abs.z)
							return new <#=vectortype#>(0, MathX.Sign(v.y), 0);

						return new <#=vectortype#>(0, 0, MathX.Sign(v.z));
					<#
						break;

					case 4:
					#>
						if(abs.x > abs.y && abs.x > abs.z && abs.x > abs.w)
							return new <#=vectortype#>(MathX.Sign(v.x), 0, 0, 0);

						if(abs.y > abs.z && abs.y > abs.w)
							return new <#=vectortype#>(0, MathX.Sign(v.y), 0, 0);

						if(abs.z > abs.w)
							return new <#=vectortype#>(0, 0, MathX.Sign(v.z), 0);

						return new <#=vectortype#>(0, 0, 0, MathX.Sign(v.w));
					<#
						break;
				}
				#>
			}

			<# if(n == 3)
			{
			#>

			static readonly <#=basetype#>Q <#=basetype#>_orthoX = <#=basetype#>Q.AxisAngle(<#=vectortype#>.Right, 90);
			static readonly <#=basetype#>Q <#=basetype#>_orthoY = <#=basetype#>Q.AxisAngle(<#=vectortype#>.Up, 90);

			// based on this: http://stackoverflow.com/questions/3684269/component-of-a-quaternion-rotation-around-an-axis
			public static void Orthonormals(in <#=vectortype#> normal, out <#=vectortype#> ortho0, out <#=vectortype#> ortho1)
			{
				var normNormal = normal.Normalized;

				var w = <#=basetype#>_orthoX * normNormal;
				if(MathX.Dot(normal,w) > 0.6f)
					w = <#=basetype#>_orthoY * normNormal;	
					
				ortho0 = MathX.Cross(normal, w);
				ortho1 = MathX.Cross(normal, ortho0);
			}

			public static void Orthonormalize(ref <#=vectortype#> normal, ref <#=vectortype#> tangent)
			{
				if(normal == <#=vectortype#>.Zero)
					normal = <#=vectortype#>.Right;
				else
					normal = normal.Normalized;

				var temp = MathX.Cross(normal, tangent);

				if(temp == <#=vectortype#>.Zero)
					temp = MathX.Cross(normal, new <#=vectortype#>(normal.z, -normal.x, normal.y));

				tangent = MathX.Cross(temp, normal).Normalized;
			}

			[MethodImpl(MethodImplOptions.AggressiveInlining)]
			public static <#=vectortype#> Cross(in <#=vectortype#> a, in <#=vectortype#> b)
			{
				return new <#=vectortype#>(
					a.y * b.z - a.z * b.y,
					a.z * b.x - a.x * b.z,
					a.x * b.y - a.y * b.x);
			}

			[MethodImpl(MethodImplOptions.AggressiveInlining)]
			public static <#=vectortype#> ReflectPoint(in <#=vectortype#> point, in <#=vectortype#> planeNormal, in <#=vectortype#> planePosition)
			{
				var offsetPoint = point - planePosition;
				var project = Project(offsetPoint, planeNormal);
				var reject = Reject(offsetPoint, planeNormal);

				return (reject - project) + planePosition;
			}

			[MethodImpl(MethodImplOptions.AggressiveInlining)]
			public static <#=vectortype#> ReflectVector(in <#=vectortype#> vector, in <#=vectortype#> planeNormal)
			{
				var project = Project(vector, planeNormal);
				var reject = Reject(vector, planeNormal);

				return reject - project;
			}

            public static <#=vectortype#> LimitSwing(<#=vectortype#> vector, in <#=vectortype#> reference, <#=basetype#> maxAngle)
            {
                var angle = MathX.Angle(vector, reference);

                if(angle <= maxAngle)
                    return vector;

                vector = vector.GetNormalized(out var length);

                return MathX.Slerp(reference, vector, (float)(maxAngle / angle)) * length;
            }

			<#
			}
			#>

			[MethodImpl(MethodImplOptions.AggressiveInlining)]
			public static bool IsBetween(this <#=vectortype#> value, in <#=vectortype#> from, in <#=vectortype#> to)
			{
				return <#=H.FormatElements(elements, "value.{0}.IsBetween(from.{0}, to.{0})", "&&")#>;
			}

			[MethodImpl(MethodImplOptions.AggressiveInlining)]
			public static <#=vectortype#> Lerp(in <#=vectortype#> from, in <#=vectortype#> to, <#=basetype#> t)
			{
				if(t <= 0)
					return from;
				if(t >= 1)
					return to;

				return from + (to - from) * t;
			}

			[MethodImpl(MethodImplOptions.AggressiveInlining)]
			public static <#=vectortype#> Lerp(in <#=vectortype#> from, <#=basetype#> to, <#=basetype#> t)
			{
				if(t <= 0)
					return from;
				if(t >= 1)
					return new <#=vectortype#>(<#=H.FormatElements(elements, "to", ", ")#>);

				return from + (to - from) * t;
			}

			[MethodImpl(MethodImplOptions.AggressiveInlining)]
			public static <#=vectortype#> Lerp(<#=basetype#> from, in <#=vectortype#> to, <#=basetype#> t)
			{
				if(t <= 0)
					return new <#=vectortype#>(<#=H.FormatElements(elements, "from", ", ")#>);
				if(t >= 1)
					return to;

				return from + (to - from) * t;
			}

			public static <#=vectortype#> Slerp(<#=vectortype#> from, in <#=vectortype#> to, float lerp)
			{
				var dot = Dot(from, to);

                // Break singularity when the vectors are nearly opposite of each other
                if(dot < -0.999999<#=literalSuffix#>)
                    from = (from + 1e-3f).Normalized;

				dot = Clamp(dot, -1, 1);

				var theta = Acos(dot)*lerp;
				var relativeVec = to - from*dot;
				relativeVec = relativeVec.Normalized;

				return ((from*Cos(theta)) + (relativeVec*Sin(theta)));
			}

            // This slerps the direction uniformly, while also lerping the magnitude
            public static <#=vectortype#> SlerpWithMagnitude(in <#=vectortype#> from, in <#=vectortype#> to, float lerp)
            {
                var fromDir = from.GetNormalized(out var fromMag);
                var toDir = to.GetNormalized(out var toMag);

                var newMag = MathX.LerpUnclamped(fromMag, toMag, lerp);

                // If one of the vectors is zero, just take the direction from the other vector
                // rather than slerping it
                if(MathX.Approximately(fromMag, 0))
                    return toDir * newMag;

                if(MathX.Approximately(toMag, 0))
                    return fromDir * newMag;

                return Slerp(fromDir, toDir, lerp) * newMag;
            }

			[MethodImpl(MethodImplOptions.AggressiveInlining)]
			public static <#=vectortype#> ClampMagnitude(in <#=vectortype#> v, <#=basetype#> maxMagnitude, <#=basetype#> minMagnitude = 0)
			{
				var mag = v.Magnitude;

				if(mag > maxMagnitude)
					return v * (maxMagnitude / mag);

				if(mag < minMagnitude && mag > 0)
					return v * (minMagnitude / mag);

				return v;
			}

		<#
		}

		if(basetype == "double")
		{
			#>
			public static <#=vectortype#> Lerp(in <#=vectortype#> from, in <#=vectortype#> to, float t)
			{
				return Lerp(from, to, (double)t);
			}
			<#
		}
		#>

		<#
	}
	
	if(basetype != "float" && basetype != "double" && basetype != "bool")
	{
		#>

			public static <#=vectortype#> Lerp(in <#=vectortype#> from, in <#=vectortype#> to, float lerp)
			{
				return new <#=vectortype#>( <#= H.FormatElements(elements,
					"Lerp(from.{0}, to.{0}, lerp)", ",") #>);
			}

            public static <#=vectortype#> LerpUnclamped(in <#=vectortype#> from, in <#=vectortype#> to, float lerp)
			{
				return new <#=vectortype#>( <#= H.FormatElements(elements,
					"LerpUnclamped(from.{0}, to.{0}, lerp)", ",") #>);
			}
		<#
	}
	
	#>
}

<#
}
