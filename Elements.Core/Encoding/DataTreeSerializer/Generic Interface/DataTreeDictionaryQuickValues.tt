<#@ template debug="false" hostspecific="false" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ assembly name="netstandard" #>
<#@ assembly name="$(SolutionDir)CodeGenerationConfig\bin\$(ConfigurationName)\netstandard2.0\CodeGenerationConfig.dll" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenerationConfig" #>
<#@ output extension=".cs" #>
// Autogenerated!!! DO NOT MODIFY!
// Generated on: <#= DateTime.Now #>

using System;

namespace Elements.Core
{
	public partial class DataTreeDictionary
	{
		#region EXTRACTING VALUES

		T ExtractValue<T>(DataTreeNode node)
		{
			var exType = typeof(T);

			if(exType.IsEnum)
				return (T)Enum.Parse(exType, ExtractValue<string>(node));
			else if(exType == typeof(string))
				return (T)(object)(node as DataTreeValue).Extract<string>();
			<#
			foreach(var type in Config.AllSupportedTypes)
			{
				#>else if(exType == typeof(<#=type.TypeDeclaration#>))
					return (T)(object)node.Load<#=type.TypeName#>();
				<#
			}
			#>
			else
				throw new Exception($"DataType {exType} isn't supported");
		}

		#endregion

		#region QUICK VALUE ADDERS

		public void Add<T>(string key, T val)
		{
			var type = typeof(T);

			if(val is DataTreeNode)
				Children.Add(key, val as DataTreeNode);
			else if(type.IsEnum)
				Children.Add(key, DataTreeValue.FromEnum(val));
			else if(type == typeof(string))
				Children.Add(key, new DataTreeValue((string)(object)val));
			<#
				foreach(var type in Config.AllSupportedTypes)
				{
					#>else if(val is <#=type.TypeDeclaration#>)
						Children.Add(key, ((<#=type.TypeDeclaration#>)(object)val).Save());
					<#
				}
			#>

			else
				throw new Exception($"Type {type} isn't supported.");
		}


		#endregion
	}
}
