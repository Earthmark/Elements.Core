<#@ template debug="false" hostspecific="false" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ assembly name="netstandard" #>
<#@ assembly name="$(SolutionDir)CodeGenerationConfig\bin\$(ConfigurationName)\netstandard2.0\CodeGenerationConfig.dll" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenerationConfig" #>
<#@ output extension=".cs" #>
// Autogenerated!!! DO NOT MODIFY!
// Generated on: <#= DateTime.Now #>
<#    return null; #>

namespace Elements.Core
{
	public partial class DataTreeValue
	{
		#region CONSTRUCTORS

		public DataTreeValue(System.DateTime val)
		{
			UpdateValue(val);
		}

		public void UpdateValue(System.DateTime val)
		{
			this.Value = val.ToBinary();
			this.Primitive = DataPrimitiveType.Long;
		}

		<#
		foreach(var type in Config.PrimitiveTypes)
		{
			#>
			public DataTreeValue(<#=type.TypeDeclaration#> val)
			{
				UpdateValue(val);
			}

			<#if(type.TypeDeclaration != "string")
			{#>
				public void UpdateValue(<#=type.TypeDeclaration#> val)
				{
					this.Value = val;
					this.Primitive = DataPrimitiveType.<#=type.TypeName#>;
				}
			<#}#>

			<#
		}
		#>


		#endregion
	}
}
