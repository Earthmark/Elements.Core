// Autogenerated!!! DO NOT MODIFY!
// Generated on: <#= DateTime.Now #>

using System;
using System.IO;
using Renderite.Shared;

namespace Elements.Core
{

public static class LoadSaveHelper
{

<#
foreach(var type in Config.AllSupportedTypes)
{
	#>

	public static DataTreeNode Save(this <#=type.TypeDeclaration#> value)
	{
		<#if(type.TypeName == "Decimal")
		{#>
			return new DataTreeValue(value.ToString(System.Globalization.CultureInfo.InvariantCulture));
		<#}
		else if(type.TypeName == "ColorX")
		{#>
			// we use base serialization of the color and tack in the profile after it for backwards compatibility
			// that way old builds will be able to load the color, even though they loose the color profile information
			var listnode = (DataTreeList)value.baseColor.Save();
			listnode.Add(DataTreeValue.FromEnum(value.profile));
			return listnode;
		<#}
		else if(type.Dimensions == 1)
		{#>
			return new DataTreeValue(value);
		<#}
		else if(type.MatrixSize == null)
		{#>
			var listnode = new DataTreeList();
			<#for(int n = 0; n < type.Dimensions; n++)
			{#>
				listnode.Add(new DataTreeValue(value[<#=n#>]));
			<#}#>

			return listnode;
		<#}
		else // Matrix type!
		{#>
			var listnode = new DataTreeList();

			for(int r = 0; r < <#=type.MatrixSize.Rows#>; r++)
			{
				var rownode = new DataTreeList();

				for(int c = 0; c < <#=type.MatrixSize.Columns#>; c++)
					rownode.Add(new DataTreeValue(value[r,c]));

				listnode.Add(rownode);
			}

			return listnode;
		<#}
		#>
	}

	public static <#=type.TypeDeclaration#> Load<#=type.TypeName#>(this DataTreeNode node)
	{
		<#if(type.Dimensions <= 1)
			{
				if(type.TypeName == "Decimal")
				{
					#>

					var valuenode = node as DataTreeValue;

					var str = "";

					if(!valuenode.IsNull)
						str = valuenode.Extract<string>();

					RobustParser.TryParse(str, out decimal d);
					return d;

					<#
				}
				else if(type.TypeName == "String")
				{
					#>
					// String needs to check for null, but this always translates into empty string
					var valuenode = node as DataTreeValue;
					if(valuenode.IsNull)
						return null;
					else
						return valuenode.Extract<string>();
					<#
				}
				else
				{
					#>
					return ((DataTreeValue)node).Extract<<#=type.TypeDeclaration#>>();
					<#
				}
			}
			else if(type.TypeName == "ColorX")
			{
				#>
				var listnode = (DataTreeList)node;
				var baseColor = node.LoadColor();
				var profile = ColorProfile.sRGBAlpha;

				// For backwards compatibility we check if there actually is 5th element in the list which contains the color profile
				// We might be loading value that was original color
				if(listnode.Count > 4)
					profile = ((DataTreeValue)listnode[4]).ExtractEnum<ColorProfile>();

				return new colorX(baseColor, profile);
				<#
			}
			else if(type.MatrixSize == null)
			{#>
				var list = (DataTreeList)node;

				// extract the individual elementary values
				return new <#=type.TypeDeclaration#>(<#=H.FormatList(type.Dimensions,
					"((DataTreeValue)list[{0}]).Extract<" + type.BaseType.TypeDeclaration + ">()", ",\n")#>
					);
			<#}
			else
			{#>
				var list = node as DataTreeList;

				<#for(int r = 0; r < type.MatrixSize.Rows; r++)
				{
					#>
					var rownode<#=r#> = list[<#=r#>] as DataTreeList;
					<#
				}

				#>return new <#=type.TypeDeclaration#>(<#

				for(int r = 0; r < type.MatrixSize.Rows; r++)
					for(int c = 0; c < type.MatrixSize.Rows; c++)
					{
						#>(rownode<#=r#>[<#=c#>] as DataTreeValue).Extract<<#=type.BaseType.TypeDeclaration#>>()<#
						if(r != type.MatrixSize.Rows - 1 || c != type.MatrixSize.Columns - 1)
							{ #>,
							<# }
					}
				#>);<#
			}
			#>
	}

	<#
}
#>

}

} // namespace FrooxEngine
