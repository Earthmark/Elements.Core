        public static <#=t#> EaseOutBounce<#=ct#>(<#=t#> time, <#=t#> begin, <#=t#> change, <#=t#> duration)
        {
            <#=t#> divisor = 2.75f;
            <#=t#> magnitude = 7.5625f;

            time /= duration;

            if (time < 1f / divisor)
            {
                return change * (magnitude * time * time) + begin;
            }
            else if (time < 2f / divisor)
            {
                time -= 1.5f / divisor;
                return change * (magnitude * time * time + 0.75f) + begin;
            }
            else if (time < 2.5f / divisor)
            {
                time -= 2.25f / divisor;
                return change * (magnitude * time * time + 0.9375f) + begin;
            }
            else
            {
                time -= 2.625f / divisor;
                return change * (magnitude * time * time + 0.984375f) + begin;
