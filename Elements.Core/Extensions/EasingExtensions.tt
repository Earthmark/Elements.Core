                amplitude = change;
                s = period / 4f;
            }
            else
                s = period / (2f * PI) * Asin(change / amplitude);

            return (amplitude * Pow(2f, -10f * time) * Sin((time * duration - s) * (2f * PI) / period)) + change + begin;
        }

        public static <#=t#> EaseInOutElastic<#=ct#>(<#=t#> time, <#=t#> begin, <#=t#> change, <#=t#> duration, <#=t#> amplitude, <#=t#> period)
