<#@ template debug="false" hostspecific="false" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ assembly name="$(SolutionDir)\Libraries\UnityAssemblies\UnityEngine.dll" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.Reflection" #>
<#@ import namespace="System.Runtime.CompilerServices" #>
<#@ import namespace="UnityEngine" #>
<#@ output extension=".cs" #>
// Autogenerated!!! DO NOT MODIFY!
// Generated on: <#= DateTime.Now #>

using System;
using System.Runtime.CompilerServices;

namespace Elements.Core
{

public static partial class MathX
{
<#
	var methods = typeof(Math).GetMethods();

	foreach(var method in methods)
	{
		if(!method.IsStatic)
			continue;

		if (excludeMethods.Contains(method.Name))
			continue;

		Gen gen = Gen.Original;

		while(gen != Gen.Done)
		{
			var returntype = ReturnType(method);
			var wrappername = method.Name;
            var className = "Math";

			if(renameMethods.ContainsKey(wrappername))
				wrappername = renameMethods[wrappername];
			

			if(gen == Gen.Float)
			{
                className = "MathF";
				returntype = "float";
				#>
				// Float Wrapper
				<#
			}

			#> 
			[MethodImpl(MethodImplOptions.AggressiveInlining)]
			public static <#=returntype#> <#=wrappername#>( <#
				var parameters = method.GetParameters();
				for(int i = 0; i < parameters.Length; i++)
				{
					var p = parameters[i];
					bool isLast = i == parameters.Length-1;
					#><#= FormatParam(p, false, gen) + (isLast?"":",") #><#
				}
			#> )
			{
				return <#=className#>.<#=method.Name#>(<#

				for(int i = 0; i < parameters.Length; i++)
				{
					var p = parameters[i];
					bool isLast = i == parameters.Length-1;
					#><#= FormatParam(p, true, gen) + (isLast?"":",") #><#
				}

				 #>);
			}

			<#

			if(gen == Gen.Original && returntype == "double" &&
				!excludeFloatGen.Contains(method.Name))
			{
				// generate a floating point wrapper
				gen = Gen.Float;
			}
			else
				gen = Gen.Done;
		}
	}
#>
}

}

<#+

enum Gen { Original, Float, Done };

List<string> excludeMethods = new List<string>()
{
	"Clamp"
};


List<string> excludeFloatGen = new List<string>()
{
	"Abs", "Min", "Max"
};

Dictionary<string, string> renameMethods = new Dictionary<string, string>()
{
	{ "Ceiling", "Ceil" },
};

Dictionary<Type, string> typeNames = new Dictionary<Type, string>()
{
	{ typeof(void), "void" },

	{ typeof(bool), "bool" },

	{ typeof(byte), "byte" },
	{ typeof(ushort), "ushort" },
	{ typeof(uint), "uint" },
	{ typeof(ulong), "ulong" },

	{ typeof(sbyte), "sbyte" },
	{ typeof(short), "short" },
	{ typeof(int), "int" },
	{ typeof(long), "long" },

	{ typeof(float), "float" },
	{ typeof(double), "double" },
	{ typeof(decimal), "decimal" },

	{ typeof(string), "string" },
};


string FormatParam(ParameterInfo p, bool skipType = false, Gen gen = Gen.Original)
{
	var t = p.ParameterType;

	string typename;
	string prefix = "";
	string suffix = "";

	if(t.IsArray)
	{
		t = t.GetElementType();
		if(!skipType)
			suffix = "[]";
	}

	if(t.IsByRef)
	{
		t = t.GetElementType();
		prefix = "ref ";
	}

	if(p.GetCustomAttributes(typeof(ParamArrayAttribute), false).Length > 0 && !skipType)
		prefix = "params ";
	if(p.IsOut)
		prefix = "out ";
		
	typename = Typename(t);

	if(gen == Gen.Float && typename == "double")
		typename = "float";

	return prefix + (skipType?"":typename) + suffix + " " + p.Name;
}

string Typename(Type t)
{
	if(typeNames.ContainsKey(t))
		return typeNames[t];
	else
		return t.Name;
}

string ReturnType(MethodInfo info)
{
    object[] returnAttrs = info.ReturnTypeCustomAttributes.GetCustomAttributes(false);
    Type returnType = info.ReturnType;

    if (returnAttrs.FirstOrDefault(obj => obj.GetType() == typeof(TupleElementNamesAttribute)) is TupleElementNamesAttribute nameAttr)
    {
        Type[] genParams = returnType.GetGenericArguments();
        IList<string?> tupleNames = nameAttr.TransformNames;

        IEnumerable<string> typeStringPairs = genParams.Select((type, i) => string.Join(' ', Typename(type), tupleNames[i]));


        return $"({string.Join(", ", typeStringPairs)})";
    }

    return Typename(returnType);
}

#>
