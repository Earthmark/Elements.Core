                3f * MathX.Pow(t, 2f) * to;
        }

		public static void OffsetRangeToZero(<#=modifier#><#=t#> min, <#=modifier#><#=t#> max, int bits, out <#=t#> newMin, out <#=t#> newMax)
        {
            if((min < 0).Any() && (max > 0).Any())
            {
                var range = max - min;

                var steps = MaxValueForBits(bits);

                // what percent of the range is the zero in?
                var zeroPercentage = -min / range;

                var zeroValue = (ulong<#=dim#>)MathX.Round(zeroPercentage * steps);
                var rightSteps = steps - zeroValue;
                var leftSteps = steps - rightSteps;
                var leftRange = -min;
                var rightRange = max;

                var leftStepSize = leftRange / leftSteps;
                var rightStepSize = rightRange / rightSteps;

                var newStepSize = MathX.Max(leftStepSize, rightStepSize);

                newMin = -(leftSteps * newStepSize);
                newMax = rightSteps * newStepSize;
            }
            else
            {
                newMin = min;
                newMax = max;
            }
        }

		public static uint<#=dim#> Quantize(<#=t#> value, <#=modifier#><#=t#> min, <#=modifier#><#=t#> max, int bits)
        {
            OffsetRangeToZero(min, max, bits, out <#=t#> newMin, out <#=t#> newMax);

            // offset it to zero
            value -= newMin;

            // scale it to 0...1 range
            value /= (newMax - newMin);

            // multiply by maximum integer value for given number of bits
			var maxValue = (uint)MaxValueForBits(bits);
            value *= maxValue;

			value = MathX.Max(0, value);

            uint<#=dim#> q = (uint<#=dim#>)value;

			//q = q.Mask(value - q >= 0.5f, q + 1U);

			q = MathX.Min(q, maxValue);

            return q;
        }

		public static <#=t#> Dequantize(<#=modifier#>uint<#=dim#> value, <#=modifier#><#=t#> min, <#=modifier#><#=t#> max, int bits)
        {
            OffsetRangeToZero(min, max, bits, out <#=t#> newMin, out <#=t#> newMax);

            <#=t#> result = value;

            var range = newMax - newMin;
            var step = 1f / MaxValueForBits(bits);

            // remap it back to the 0...1 range
            result *= step;

            // remap back to the original range
            result *= range;

            // shift by the minimum
            result += newMin;

            // clamp to the original min/max range
            result = MathX.Clamp(result, min, max);

            return result;
        }

