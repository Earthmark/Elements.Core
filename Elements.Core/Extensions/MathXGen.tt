        public static <#=t#> BezierCurve(<#=t#> from, <#=t#> to, <#=t#> fromTangent, <#=t#> toTangent, float t)
        {
            var u = 1f - t;
            var tt = t * t;
            var uu = u * u;
            var ttt = tt * t;
            var uuu = uu * u;

            return uuu * from +
                (3 * uu * t * fromTangent) +
                (3 * u * tt * toTangent) +
                ttt * to;
        }

        public static <#=t#> BezierTangent(<#=t#> from, <#=t#> to, <#=t#> fromTangent, <#=t#> toTangent, float t)
