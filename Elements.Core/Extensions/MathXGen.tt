					abc = value.yzw;
                    sign = value.x < 0;
                    break;

                case 1:
					abc = value.xzw;
                    sign = value.y < 0;
                    break;

                case 2:
					abc = value.xyw;
                    sign = value.z < 0;
                    break;

                case 3:
