            else if((dec.Contains("float") || dec.Contains("double") || dec.Contains("color") || dec.Contains("decimal")) && dec != "color32")
            {
                #>
                public static bool TryParse(string str, out <#=dec#> value)  => TryParse(str, NumberStyles.Float, out value);

				public static bool TryParse(string str, NumberStyles style, out <#=dec#> value) 
                {
                    if(string.IsNullOrWhiteSpace(str))
                    {
                        value = default;
                        return false;
                    }

                    var localParsed = <#=dec#>.TryParse(str, style, CultureInfo.CurrentCulture, out <#=dec#> localValue);
                    var invariantParsed = <#=dec#>.TryParse(str, style, CultureInfo.InvariantCulture, out <#=dec#> invariantValue);

                    if(!localParsed && !invariantParsed)
                    {
                        value = default;
                        return false;
                    }

                    if(localParsed && invariantParsed)
                    {
                        // both parsed, but one is clearly wrong
                        bool useLocal = false;

                        var elementCount = typeof(<#=dec#>).GetElementCount();

                        for(int e = 0; e < elementCount; e++)
                        {
                            var l = MathX.Frac(MathX.Abs(localValue.GetElement(e)));
                            var i = MathX.Frac(MathX.Abs(invariantValue.GetElement(e)));

                            if(l == i)
                                continue;

                            if(l > i)
                            {
                                useLocal = true;
                                break;
                            }
                        }

                        if(useLocal)
                            value = localValue;
                        else
                            value = invariantValue;

                        return true;
                    }

                    if(localParsed)
                    {
                        value = localValue;
                        return true;
                    }
                    else
                    {
                        value = invariantValue;
                        return true;
                    }
