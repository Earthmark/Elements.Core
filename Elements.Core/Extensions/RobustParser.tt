            else if(dec.Contains("bool") || dec == "char" || dec.Contains("DateTime") || dec.Contains("TimeSpan"))
            {
                #>
                public static bool TryParse(string str, out <#=dec#> value) 
                {
                    return <#=dec#>.TryParse(str, out value);
